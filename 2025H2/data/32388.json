                {
                    "file": "test/ciphersuite_unittest.cpp",
                    "line": 10,
                    "reviewer": {
                        "name": "Vernon Mauery",
                        "email": "vernon.mauery@gmail.com",
                        "username": "vmauery"
                    },
                    "message": "std::string cannot be constexpr in c++17. const std::string or constexpr const char [] are both fine, but if the const char * must be promoted to a std::string every time it is used, it might be better to be a const std::string so it can be constructed only once."
                },
                {
                    "file": "test/ciphersuite_unittest.cpp",
