                    "line": 12,
                    "reviewer": {
                        "name": "Amithash Prasad",
                        "email": "amithash@meta.com",
                        "username": "amithash"
                    },
                    "message": "do you really need to do this? I was thinking of just having it unpacked into tools/dreport.d/plugins.d was sufficient."
                },
                {
                    "file": "meta-facebook/meta-ventura/recipes-phosphor/dump/phosphor-debug-collector_%.bbappend",
                    "line": 12,
                    "reviewer": {
                        "name": "Patrick Williams",
