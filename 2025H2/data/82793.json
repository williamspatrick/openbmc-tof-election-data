            "comments": [
                {
                    "file": "meta-facebook/meta-yosemite4/recipes-yosemite4/plat-svc/files/yosemite4-early-sys-init",
                    "line": 78,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "No more custom `Logging.Create` calls.  We should be using `log-create`."
                },
                {
                    "file": "meta-facebook/meta-yosemite4/recipes-yosemite4/plat-svc/files/yosemite4-early-sys-init",
                    "line": 78,
                    "reviewer": {
                        "name": "Hoik Chen",
                        "email": "hoik.chen.wiwynn@gmail.com",
                        "username": "hoikchen-wiwynn"
                    },
                    "message": "OK I will modify it.\nI will add a new event.yaml in `phosphor-dbus-interfaces` because I didn't find a suitable one for this event log in `log-create`."
                },
                {
                    "file": "meta-facebook/meta-yosemite4/recipes-yosemite4/plat-svc/files/yosemite4-early-sys-init",
                    "line": 78,
                    "reviewer": {
                        "name": "Hoik Chen",
                        "email": "hoik.chen.wiwynn@gmail.com",
                        "username": "hoikchen-wiwynn"
                    },
                    "message": "Hi @patrick@stwcx.xyz,\nI already modify it from using `Logging.Create` to using `log-create`.\nI found that there hasn't a suitable event for this log using in `phosphor-dbus-interfaces`, so I add a new event in `yaml/xyz/openbmc_project/State/BMC.events.yaml` as following gerrit link.\nhttps://gerrit.openbmc.org/c/openbmc/phosphor-dbus-interfaces/+/83113"
                },
                {
                    "file": "meta-facebook/meta-yosemite4/recipes-yosemite4/plat-svc/files/yosemite4-early-sys-init",
                    "line": 78,
                    "reviewer": {
                        "name": "Hoik Chen",
                        "email": "hoik.chen.wiwynn@gmail.com",
                        "username": "hoikchen-wiwynn"
                    },
                    "message": "Hi @patrick@stwcx.xyz,\nI\u2019ve updated the code based on your feedback.\nCould you please help review it again when you have time?\nThank you!"
                },
                {
                    "file": "meta-facebook/meta-yosemite4/recipes-yosemite4/plat-svc/files/yosemite4-early-sys-init",
                    "line": 217,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Can we figure out a way to do this common for everyone using `phosphor-static-norootfs` rather than it being custom for Yv4?"
                },
                {
                    "file": "meta-facebook/meta-yosemite4/recipes-yosemite4/plat-svc/files/yosemite4-early-sys-init",
                    "line": 217,
                    "reviewer": {
                        "name": "Hoik Chen",
                        "email": "hoik.chen.wiwynn@gmail.com",
                        "username": "hoikchen-wiwynn"
                    },
                    "message": "Do you mean this function should write in `phosphor-static-norootfs` instead of `yosemite4-early-sys-init`?\nBut I'm not sure whether this command `cat /run/media/slot` can be used for other platforms to judge boot flash.\nMay I know if there is a command that can do this for every platform? Thanks."
                },
                {
                    "file": "meta-facebook/meta-yosemite4/recipes-yosemite4/plat-svc/files/yosemite4-early-sys-init",
                    "line": 217,
                    "reviewer": {
                        "name": "Hoik Chen",
                        "email": "hoik.chen.wiwynn@gmail.com",
                        "username": "hoikchen-wiwynn"
                    },
                    "message": "Hi, sorry for ask again.\nI didn't find the repo of `phosphor-static-norootfs`.\nDoes it is a repo? or may I know where I can find this file to add this function for every platform using.\nThanks."
                },
                {
                    "file": "meta-facebook/meta-yosemite4/recipes-yosemite4/plat-svc/files/yosemite4-early-sys-init",
                    "line": 217,
                    "reviewer": {
                        "name": "Hoik Chen",
                        "email": "hoik.chen.wiwynn@gmail.com",
                        "username": "hoikchen-wiwynn"
                    },
                    "message": "I found a similar file at this path `meta-facebook/meta-yosemite4/recipes-phosphor/initrdscripts/phosphor-static-norootfs-init`.\nDo you mean that I should put this add SEL function in `99-platform-init` which is under this path? or did I misunderstand you?"
                }
            ],
