                    "file": "src/adc/ADCSensorMain.cpp",
                    "line": 336,
                    "reviewer": {
                        "name": "Harshit Aghera",
                        "email": "haghera@nvidia.com",
                        "username": "harshit-aghera"
                    },
                    "message": "Do we need to check for any errors related to dbus signals?"
                },
                {
                    "file": "src/adc/ADCSensorMain.cpp",
                    "line": 336,
                    "reviewer": {
                        "name": "George Liu",
                        "email": "liuxiwei@ieisystem.com",
                        "username": "lxwinspur"
                    },
                    "message": "For D-Bus signals, we do not need to check `is_method_error()` or any other method-error related status."
                },
