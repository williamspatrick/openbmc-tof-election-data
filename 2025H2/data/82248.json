            "comments": [
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Ewelina Walkusz",
                        "email": "ewelinax.walkusz@intel.com",
                        "username": "ewalkusx"
                    },
                    "message": "With gcc 15.0.1 there is this problem:\n\nWhen GoogleMock tries to compare a std::function containing std::expected<bool, boost::system::error_code> with nullptr, it triggers the std::expected operator== template resolution, which creates a circular constraint dependency.\nmore: https://github.com/google/googletest/issues/4759\n\nThis is fixed in gcc 15.2.0"
                }
            ],
