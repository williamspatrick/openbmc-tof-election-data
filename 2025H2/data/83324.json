            "comments": [
                {
                    "file": "meta-ibm/recipes-connectivity/openssh/openssh_%.bbappend",
                    "line": 12,
                    "reviewer": {
                        "name": "Joseph Reynolds",
                        "email": "joseph.reynolds1@ibm.com",
                        "username": "joseph-reynolds"
                    },
                    "message": "My previous comment to remove all UMACs was incorrect.  The UMAC-64 is considered weaker (easier to forge) than UMAC-128, but there is no reason to remove UMAC-128.\nI believe we should keep the umac-128-* algorithms, and only remove the umac-64.  So the configuration line would read like this:\n```\nMACs -hmac-sha1*,umac-64*\n```"
                }
            ],
