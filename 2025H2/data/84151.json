            "kind": "REWORK",
            "comments": [
                {
                    "file": "/COMMIT_MSG",
                    "line": 16,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "I don't think we should have phosphor-virtual-sensors report an InvalidSensorReading event for NaN results, especially ones which are purely software calculations.  The Redfish event is really suppose to indicate some kind of repair action that should be done on the system, but a phosphor-virtual-sensor does not point to any specific hardware repair action that needs to take place.  If there is a real hardware sensor failure, the underlying dbus-sensor would/should have already reported this event."
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 16,
                    "reviewer": {
                        "name": "Kimi Chen",
                        "email": "kimi.zy.chen@fii-foxconn.com",
                        "username": "zuyan-kimi"
                    },
                    "message": "OK, I understand. \nI will abandon this commit and focus on the sensor event feature for the dbus-sensor."
                }
            ],
