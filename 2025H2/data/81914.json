            "kind": "NO_CODE_CHANGE",
            "comments": [
                {
                    "file": "/COMMIT_MSG",
                    "line": 15,
                    "reviewer": {
                        "name": "Gunnar Mills",
                        "email": "gunnar@gmills.xyz",
                        "username": "gtmills"
                    },
                    "message": "Is being deprecated by Redfish? \n\nI think it is reasonable to have a PCIeDevice -> connected_to -> Cpu \nIMO, this should be rewrote to not include Redfish and just state this is a connected_to association just like the PCIeSlot can be connected_to"
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 15,
                    "reviewer": {
                        "name": "Gunnar Mills",
                        "email": "gunnar@gmills.xyz",
                        "username": "gtmills"
                    },
                    "message": "Filling out the Link in Redfish: PCIeDevice -> Cpu seems like a reasonable use case but I think this is broader than just Redfish deprecated"
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 15,
                    "reviewer": {
                        "name": "Myung Bae",
                        "email": "myungbae@us.ibm.com",
                        "username": "baemyung"
                    },
                    "message": "https://www.dmtf.org/sites/default/files/standards/documents/DSP2046_2024.2.html#pcieslots-161-deprecated says that PCIeSlots is deprecated from v1.6.1.\n\n>IMO, this should be rewrote to not include Redfish and just state this is a connected_to association just like the PCIeSlot can be connected_to\nI rephrased it."
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 15,
                    "reviewer": {
                        "name": "Myung Bae",
                        "email": "myungbae@us.ibm.com",
                        "username": "baemyung"
                    },
                    "message": "Done"
                },
