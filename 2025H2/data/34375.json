                    "line": 539,
                    "reviewer": {
                        "name": "Sumanth Bhat",
                        "email": "sumanth.bhat@linux.intel.com",
                        "username": "sumbhat90"
                    },
                    "message": "Suppose there were extra messages in the tx queue (which were appended to the queue when tx was disabled), they don't have to be flushed out. Only for a particular message where transmit fails needs to be flushed out."
                },
