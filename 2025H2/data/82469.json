            "comments": [
                {
                    "file": "platform-mc/terminus_manager.cpp",
                    "line": 434,
                    "reviewer": {
                        "name": "Thu Nguyen",
                        "email": "thu@os.amperecomputing.com",
                        "username": "ThuBaNguyen"
                    },
                    "message": "What happen when the terminus already has the terminus name PDRs?\nWhich name will be chosen?"
                },
                {
                    "file": "platform-mc/terminus_manager.cpp",
                    "line": 434,
                    "reviewer": {
                        "name": "Kevin Tung",
                        "email": "kevin.tung.openbmc@gmail.com",
                        "username": "kevintungquanta"
                    },
                    "message": "The terminus name is determined as follows:\n- If neither EM nor PDRs provide a terminus name, it will be empty.\n- If EM provides a terminus name but PDRs do not, the EM-defined name will be used.\n- If both EM and PDRs provide a terminus name, the PDRs-defined name will override the EM-defined name.\n\nTherefore, if the terminus already has a terminus name in the PDRs, the name in the PDRs will be chosen."
                },
                {
                    "file": "platform-mc/terminus_manager.cpp",
                    "line": 434,
                    "reviewer": {
                        "name": "ManojKiran Eda",
                        "email": "manojkiran.eda@gmail.com",
                        "username": "manojkiraneda"
                    },
                    "message": "Kevin, \n\nCould u please add this to the commit message stating, what takes the highest precedence and over what ? I don't want this to be buried in the comments and in code."
                },
                {
                    "file": "platform-mc/terminus_manager.cpp",
                    "line": 434,
                    "reviewer": {
                        "name": "Kevin Tung",
                        "email": "kevin.tung.openbmc@gmail.com",
                        "username": "kevintungquanta"
                    },
                    "message": "Sure, added to the commit message."
                }
            ],
