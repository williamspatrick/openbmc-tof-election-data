            "comments": [
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "This is one of a few different SPDX/copyright related changes I've seen.  Before we merge this, I'd like to get consensus on how we should handle these at a project level and then make sure this commit aligns with it.\n\nhttps://gerrit.openbmc.org/c/openbmc/docs/+/83998"
                },
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Christopher Meis",
                        "email": "christopher.meis@9elements.com",
                        "username": "ChriMarMe"
                    },
                    "message": "Sure thing. Sounds good to have a project wide alignment in that regard.\nI'll leave it unresolved for now until consensus is reached."
                },
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Christopher Meis",
                        "email": "christopher.meis@9elements.com",
                        "username": "ChriMarMe"
                    },
                    "message": "In some files the copywrite mentions Facebook, IBM and 9elements, should we keep it in these files or change it OpenBMC Authors?\n\nOtherwise I think this is ready, because the agreement how to handle Copywrite markers has been merged."
                },
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Please convert the IBM ones as-is to SPDX.  You can convert the Facebook and 9elements ones to OpenBMC Authors and after you do that, I will amend your commit with my signed-off-by to give indication that Meta(Facebook) is authorizing the removal of our copyright indicator."
                },
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Christopher Meis",
                        "email": "christopher.meis@9elements.com",
                        "username": "ChriMarMe"
                    },
                    "message": "Done"
                }
            ],
