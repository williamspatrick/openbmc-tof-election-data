            "kind": "REWORK",
            "comments": [
                {
                    "file": "meta-facebook/meta-ventura/recipes-phosphor/sensors/dbus-sensors/deassert-leak-handler",
                    "line": 63,
                    "reviewer": {
                        "name": "Jagpal S Gill",
                        "email": "paligill@gmail.com",
                        "username": "jagpalgill"
                    },
                    "message": "Why do you need to check the status here again? This service gets called from LeakDetector which already sets and resets the DBus interface.\n\nIs it because you want both Big and Small Leaks to be Normal to turn off the Port's Leak Led, if yes, please add a comment above explaining so, its little hard to understand this."
                },
                {
                    "file": "meta-facebook/meta-ventura/recipes-phosphor/sensors/dbus-sensors/deassert-leak-handler",
                    "line": 63,
                    "reviewer": {
                        "name": "Jagpal S Gill",
                        "email": "paligill@gmail.com",
                        "username": "jagpalgill"
                    },
                    "message": "This if condition is too long to read. Please define vars smallLeakStatus and bigLeakStatus and use those in if condition."
                },
                {
                    "file": "meta-facebook/meta-ventura/recipes-phosphor/sensors/dbus-sensors/deassert-leak-handler",
                    "line": 63,
                    "reviewer": {
                        "name": "Jason Hsu",
                        "email": "jason-hsu@quantatw.com",
                        "username": "QuantaJasonHsu"
                    },
                    "message": "We have changed it to define smallLeakStatus and bigLeakStatus, and simplified the if conditional checks. Thank you."
                },
                {
                    "file": "meta-facebook/meta-ventura/recipes-phosphor/sensors/dbus-sensors/deassert-leak-handler",
                    "line": 63,
                    "reviewer": {
                        "name": "Jason Hsu",
                        "email": "jason-hsu@quantatw.com",
                        "username": "QuantaJasonHsu"
                    },
                    "message": "Yes, we need to ensure that both the Big and Small Leak statuses are Normal before turning off the port\u2019s leak amber LED. We appreciate your suggestion and have added a comment to make this section easier to understand."
                }
            ],
