            "comments": [
                {
                    "file": "meta-facebook/meta-bletchley/recipes-phosphor/ipmi/phosphor-ipmi-fru_%.bbappend",
                    "line": 5,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "It's not clear to me why this should become bletchley-only.  Should we make a new version of bletchley-ipmi-fru.yaml for bletchley1.5?"
                },
                {
                    "file": "meta-facebook/meta-bletchley/recipes-phosphor/ipmi/phosphor-ipmi-fru_%.bbappend",
                    "line": 5,
                    "reviewer": {
                        "name": "EricChiangQuanta",
                        "email": "eric.chiang@quantatw.com",
                        "username": "EricChiangQuanta"
                    },
                    "message": "We preserve bletchley old method (use bletchley-ipmi-fru.yaml to setup where to read MAC address). At  bletchley1.5 we're using the new meyhod, let entity-manager \n config handle instead.\n Do you want both of them use the same method?\n If yes, which one do you prefer?"
                },
                {
                    "file": "meta-facebook/meta-bletchley/recipes-phosphor/ipmi/phosphor-ipmi-fru_%.bbappend",
                    "line": 5,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Ok.  Yes, let's use EM instead.  Would we be able to port Bletchley over to that method also?"
                },
                {
                    "file": "meta-facebook/meta-bletchley/recipes-phosphor/ipmi/phosphor-ipmi-fru_%.bbappend",
                    "line": 5,
                    "reviewer": {
                        "name": "EricChiangQuanta",
                        "email": "eric.chiang@quantatw.com",
                        "username": "EricChiangQuanta"
                    },
                    "message": "Yes, we will also change EM config for Bletchley."
                }
            ],
