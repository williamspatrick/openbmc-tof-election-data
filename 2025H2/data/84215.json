            "comments": [
                {
                    "file": "/COMMIT_MSG",
                    "line": 17,
                    "reviewer": {
                        "name": "Jagpal S Gill",
                        "email": "paligill@gmail.com",
                        "username": "jagpalgill"
                    },
                    "message": "I understand you are trying to reduce false alarms , but this looks unsafe if host is not shutdown in case of fan failure. Who will take care of host shutdown if you remove the auto shutdown?"
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 17,
                    "reviewer": {
                        "name": "sksekar",
                        "username": "sksekar"
                    },
                    "message": "\"host shutdown due to fan failure\" is a newly requested feature but not available in the fleet yet. In the absence of this, the systems will be shutdown due to other thermal related events (from NICs, DC-SCM etc)."
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 17,
                    "reviewer": {
                        "name": "Jagpal S Gill",
                        "email": "paligill@gmail.com",
                        "username": "jagpalgill"
                    },
                    "message": "Acknowledged"
                },
                {
                    "file": "meta-facebook/meta-catalina/recipes-phosphor/fans/phosphor-fan/clemente/config.json",
                    "line": 307,
                    "reviewer": {
                        "name": "Jagpal S Gill",
                        "email": "paligill@gmail.com",
                        "username": "jagpalgill"
                    },
                    "message": "What is this delay for? Would it make sense to tune this instead of dropping the whole power_off_config section?"
                },
                {
                    "file": "meta-facebook/meta-catalina/recipes-phosphor/fans/phosphor-fan/clemente/config.json",
                    "line": 307,
                    "reviewer": {
                        "name": "sksekar",
                        "username": "sksekar"
                    },
                    "message": "This power_off feature is newly added (never available in the fleet). Given that this feature requires more testing, I think it's better to drop until we have it fully tested across all fan vendors."
                },
                {
                    "file": "meta-facebook/meta-catalina/recipes-phosphor/fans/phosphor-fan/clemente/config.json",
                    "line": 307,
                    "reviewer": {
                        "name": "Jagpal S Gill",
