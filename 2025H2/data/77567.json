                "name": "SwethaParasa",
                "email": "parasa.swetha1@ibm.com",
                "username": "SwethaParasa"
            },
            "kind": "REWORK",
            "comments": [
                {
                    "file": "core_manager.cpp",
                    "line": 107,
                    "reviewer": {
                        "name": "MARRI DEVENDER RAO",
                        "email": "devenrao@in.ibm.com",
                        "username": "devenrao"
                    },
                    "message": "i think we should use a timer to trigger the callback not sleep it will block the caller for 60 seconds and it might hit the D-Bus call timeout.\n\nhttps://github.com/openbmc/sdeventplus/blob/master/src/sdeventplus/source/time.hpp"
                },
                {
                    "file": "core_manager.cpp",
                    "line": 107,
                    "reviewer": {
                        "name": "Dhruvaraj S",
                        "email": "dhruvaraj@gmail.com",
                        "username": "dhruvibm"
                    },
                    "message": "This is not a DBus service, but we will miss inotify notifications during this sleep. I think a generic queue and periodically clearing the queue can be even better"
