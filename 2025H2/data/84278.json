            "kind": "REWORK",
            "comments": [
                {
                    "file": "i2c-vr/mps/mp994x.cpp",
                    "line": 24,
                    "reviewer": {
                        "name": "Christopher Meis",
                        "email": "christopher.meis@9elements.com",
                        "username": "ChriMarMe"
                    },
                    "message": "Do we need the '08' suffix?"
                },
                {
                    "file": "i2c-vr/mps/mp994x.cpp",
                    "line": 24,
                    "reviewer": {
                        "name": "Kevin Tung",
                        "email": "kevin.tung.openbmc@gmail.com",
                        "username": "kevintungquanta"
                    },
                    "message": "In the MPS9945 datasheet, \u201c08\u201d is the suffix of the USER_DATA_08 (B8h) command. I think it\u2019s better to keep the original naming as defined in the datasheet."
                },
                {
                    "file": "i2c-vr/mps/mp994x.cpp",
                    "line": 24,
                    "reviewer": {
                        "name": "Christopher Meis",
                        "email": "christopher.meis@9elements.com",
                        "username": "ChriMarMe"
                    },
                    "message": "Done"
                },
                {
                    "file": "i2c-vr/mps/mps.hpp",
                    "line": 191,
                    "reviewer": {
                        "name": "Christopher Meis",
                        "email": "christopher.meis@9elements.com",
                        "username": "ChriMarMe"
                    },
                    "message": "I think this should be broken out into an addional patch with its own commit message."
                },
                {
                    "file": "i2c-vr/mps/mps.hpp",
                    "line": 191,
                    "reviewer": {
                        "name": "Kevin Tung",
                        "email": "kevin.tung.openbmc@gmail.com",
                        "username": "kevintungquanta"
                    },
                    "message": "This modification allows other MPS VR implementations to extend or customize how the image parser extracts data. It was introduced because the MP9945 VR image includes additional fields that require a different parsing approach from other MPS VRs. Since this change is directly related to enabling MP9945 image parsing, I don\u2019t see a clear benefit in splitting it into a separate patch."
                },
                {
                    "file": "i2c-vr/mps/mps.hpp",
                    "line": 191,
                    "reviewer": {
                        "name": "Christopher Meis",
                        "email": "christopher.meis@9elements.com",
                        "username": "ChriMarMe"
                    },
                    "message": "Done"
                },
                {
                    "file": "i2c-vr/mps/mps.hpp",
                    "line": 191,
                    "reviewer": {
                        "name": "Kevin Tung",
                        "email": "kevin.tung.openbmc@gmail.com",
                        "username": "kevintungquanta"
                    },
                    "message": "Hi @christopher.meis@9elements.com, I\u2019ve split it into a separate patch https://gerrit.openbmc.org/c/openbmc/phosphor-bmc-code-mgmt/+/84455 to extend the MPS image parser functionality."
                }
            ],
