            "kind": "TRIVIAL_REBASE",
            "comments": [
                {
                    "file": "/COMMIT_MSG",
                    "line": 10,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "Can you talk through why the existing implementation wasn't enough?\n\nhttps://github.com/openbmc/dbus-sensors/blob/aba6fcac54aba04c8ce03d8aea7cdf30922f34d8/src/sensor.hpp#L273"
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 10,
                    "reviewer": {
                        "name": "Potin Lai",
                        "email": "potin.lai@quantatw.com",
                        "username": "potinlai"
                    },
                    "message": "Hi @ed@tanous.net, Current SmbpbiSensor implementation does not assign the PowerState config, so it will be set to `PowerState::always` by default.\n\nThis commit updates the SmbpbiSensor constructor to ensure the PowerState value can be configured correctly."
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 10,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "Other sensors rely on the implementation in sensor.hpp.  Any reason we need more than that here?"
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 10,
                    "reviewer": {
                        "name": "Potin Lai",
                        "email": "potin.lai@quantatw.com",
                        "username": "potinlai"
                    },
                    "message": "@ed@tanous.net, I think you were referring to the callback implementation for power state changes. Please let me know if I misunderstood.\n\nI tested again after removing all callback implementations, and it turns out they are not needed.\n\nI\u2019ve uploaded the new patch set, could you please review it again? Thanks!"
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 10,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "Yep, you got it."
                }
            ],
