                    "line": 103,
                    "reviewer": {
                        "name": "Asmitha Karunanithi",
                        "email": "asmitk01@in.ibm.com",
                        "username": "asmithakarun"
                    },
                    "message": "We need not necessarily match it with lldp transmit frequency.\nBecause, the neighboring device might have different transmitting frequency and the current receiving device will not know about it.\n\nSo we can configure any reasonable timer frequency here."
                },
                {
                    "file": "src/lldp/lldp_interface.cpp",
