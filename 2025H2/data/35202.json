            "comments": [
                {
                    "file": "recipes-phosphor/vpd/mihawk-250soc-vpd-parser/enable-ibm-parser.sh",
                    "line": 2,
                    "reviewer": {
                        "name": "Santosh Puranik",
                        "email": "santosh.puranik.ibm@gmail.com",
                        "username": "santoshpuranik"
                    },
                    "message": "I am a little confused with this file. Is there a reason why the parser cannot be invoked based on, say a udev rule like the openpower vps parser is? How many of these bitware cards can be there on a system?"
                },
                {
                    "file": "recipes-phosphor/vpd/mihawk-250soc-vpd-parser/enable-ibm-parser.sh",
                    "line": 2,
                    "reviewer": {
                        "name": "Andy_YF Wang",
                        "email": "Andy_YF_Wang@wistron.com",
                        "username": "AndyYFWang"
                    },
                    "message": "Hi Santosh,\nThere are eight slots on the Mihawk motherboard, and any slot may be used by bittware-250-soc.\nI can't predict which slot the user will use to implement 250-soc, so I have to take into account the situations in every slot which may be used by bittware-250-soc. \nMy solution is to use this script to confirm which slot on the Mihawk motherboard is used by bittware-250-soc, and then start ipz-parser to parse the VPD data of its eeprom."
                }
            ],
