            "comments": [
                {
                    "file": "phosphor-power-sequencer/src/standard_device.hpp",
                    "line": 94,
                    "reviewer": {
                        "name": "Matt Spinler",
                        "email": "spinler@us.ibm.com",
                        "username": "spinler"
                    },
                    "message": "Why would this need to be virtual?"
                },
                {
                    "file": "phosphor-power-sequencer/src/standard_device.hpp",
                    "line": 94,
                    "reviewer": {
                        "name": "Shawn McCarney",
                        "email": "shawnmm@us.ibm.com",
                        "username": "smccarney"
                    },
                    "message": "The method is declared in the parent class, PowerSequencerDevice, which is an abstract base class with all pure virtual methods.\n\nI know in C++ you are not required to repeat the virtual keyword in subclasses, but I like doing it to remind myself the method is virtual.\n\nYou are right that child classes are not likely going to change this, but I didn't want to prevent that with final."
                },
                {
                    "file": "phosphor-power-sequencer/src/standard_device.hpp",
                    "line": 94,
                    "reviewer": {
                        "name": "Matt Spinler",
                        "email": "spinler@us.ibm.com",
                        "username": "spinler"
                    },
                    "message": "Acknowledged"
                }
            ],
