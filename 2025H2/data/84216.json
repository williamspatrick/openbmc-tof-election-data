            "kind": "REWORK",
            "comments": [
                {
                    "file": "yaml/xyz/openbmc_project/Metric/Threshold.events.yaml",
                    "line": 6,
                    "reviewer": {
                        "name": "Jagpal S Gill",
                        "email": "paligill@gmail.com",
                        "username": "jagpalgill"
                    },
                    "message": "This is an event and not an error as per Redfish specification https://github.com/DMTF/Redfish-Publications/blob/main/registries/Telemetry.1.1.1.json#L203, so lets change this to an event."
                },
                {
                    "file": "yaml/xyz/openbmc_project/Metric/Threshold.events.yaml",
                    "line": 6,
                    "reviewer": {
                        "name": "Zane Li",
                        "email": "zane.li.wiwynn@gmail.com",
                        "username": "Zane-wiwynn"
                    },
                    "message": "Done"
                },
                {
                    "file": "yaml/xyz/openbmc_project/Metric/Threshold.events.yaml",
                    "line": 12,
                    "reviewer": {
                        "name": "Jagpal S Gill",
                        "email": "paligill@gmail.com",
                        "username": "jagpalgill"
                    },
                    "message": "Lets name this ReadingValue as this is the reading value which became equal to the expected internal value (As per https://github.com/DMTF/Redfish-Publications/blob/main/registries/Telemetry.1.1.1.json#L202C24-L202C109). This will also keep it consistent with other messages."
                },
                {
                    "file": "yaml/xyz/openbmc_project/Metric/Threshold.events.yaml",
                    "line": 12,
                    "reviewer": {
                        "name": "Zane Li",
                        "email": "zane.li.wiwynn@gmail.com",
                        "username": "Zane-wiwynn"
                    },
                    "message": "Done"
                },
                {
                    "file": "yaml/xyz/openbmc_project/Metric/Threshold.events.yaml",
                    "line": 16,
                    "reviewer": {
                        "name": "Jagpal S Gill",
                        "email": "paligill@gmail.com",
                        "username": "jagpalgill"
                    },
                    "message": "What would the TriggerName property hold? Its better to make this explicit to keep it consistent."
                },
                {
                    "file": "yaml/xyz/openbmc_project/Metric/Threshold.events.yaml",
                    "line": 16,
                    "reviewer": {
                        "name": "Zane Li",
                        "email": "zane.li.wiwynn@gmail.com",
                        "username": "Zane-wiwynn"
                    },
                    "message": "Currently I\u2019m using the following format for TriggerName:\n\n\"<type>_<bound>\"\n\ne.g. Warning_Lower\n\nI\u2019d like to align with the expected convention here \u2014 do you have a preferred naming format or examples I should follow?"
                }
            ],
