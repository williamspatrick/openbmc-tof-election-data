                    "file": "platform-mc/state_sensor.hpp",
                    "line": 144,
                    "reviewer": {
                        "name": "apuli2",
                        "email": "apuli@nvidia.com",
                        "username": "apuli2"
                    },
                    "message": "nullptr can't be represented by Const reference. Using weak_ptr is extra overhead of ref-counting with no real benefit."
                },
                {
                    "file": "platform-mc/state_sensor.hpp",
                    "line": 144,
                    "reviewer": {
                        "name": "Aditya Kurdunkar",
