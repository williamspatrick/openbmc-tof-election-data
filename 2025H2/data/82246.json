                    "line": 231,
                    "reviewer": {
                        "name": "Shawn McCarney",
                        "email": "shawnmm@us.ibm.com",
                        "username": "smccarney"
                    },
                    "message": "Based on an offline conversation, the following sections are examples vs. a definitive list.  This might be clearer if you made them a bullet list and said \"Example:\" before the list."
                },
