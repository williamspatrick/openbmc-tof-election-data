            "comments": [
                {
                    "file": "designs/device-tree-gpio-naming.md",
                    "line": 228,
                    "reviewer": {
                        "name": "Shawn McCarney",
                        "email": "shawnmm@us.ibm.com",
                        "username": "smccarney"
                    },
                    "message": "This sentence is a little confusing.  If the idea is that a GPIO that already has \"chassis\" in the name doesn't need an additional \"chassisN\" added to it, that makes sense.  It might help to spell that out a little clearer though.  e.g. if the GPIO already contains \"chassis\", the chassis number should be appended to that word vs adding another word."
                },
                {
                    "file": "designs/device-tree-gpio-naming.md",
                    "line": 228,
                    "reviewer": {
                        "name": "Derek Howard",
                        "email": "derekh@us.ibm.com",
                        "username": "derekhoward55"
                    },
                    "message": "Good clarification, updated, thanks."
                },
                {
