            "kind": "REWORK",
            "comments": [
                {
                    "file": "meta-hr630/recipes-phosphor/lenovo-powerctrl/lenovo-powerctrl.bb",
                    "line": 0,
                    "reviewer": {
                        "name": "Benjamin Fair",
                        "email": "benjaminfair@google.com",
                        "username": "BenjaminFair"
                    },
                    "message": "Looking through the OpenBMC fork at https://github.com/LenovoHS/openbmc, there are multiple recipes called lenovo-powerctrl with one in each meta-machine layer. The dependency for lenovo-powerctrl comes from the meta-common layer. This will cause issues if multiple layers are enabled at once since the recipes will conflict.\n\nThe right way to do this is with a virtual target and PREFERRED_PROVIDER."
                }
            ],
            "files": [
                {
                    "file": "/COMMIT_MSG",
                    "type": "ADDED",
                    "insertions": 17,
                    "deletions": 0
