            "kind": "REWORK",
            "comments": [
                {
                    "file": "tools/dreport.d/plugins.d/hoststate",
                    "line": 9,
                    "reviewer": {
                        "name": "Jayanth Othayoth",
                        "email": "ojayanth@gmail.com",
                        "username": "ojayanth"
                    },
                    "message": "Nit: Optimize this logic with single host file name same as previously?\nservices=$(busctl list | awk '{print $1}' | grep -E \"xyz.openbmc_project.State.Host([0-9]*)?$\")\n\nfor service in ${services}; do\n    objpath=$(busctl tree --list $service | tail -n 1)\n    index=$(echo \"$service\" | grep -o '[0-9]*$')\n\n    if [ -z \"$index\" ]; then\n        file_name=\"host-state.log\"\n        desc=\"Host State\"\n    else\n        file_name=\"host${index}-state.log\"\n        desc=\"Host${index} State\"\n    fi\n\n    command=\"busctl get-property ${service} ${objpath} \\\n              xyz.openbmc_project.State.Host CurrentHostState\"\n    add_cmd_output \"$command\" \"$file_name\" \"$desc\"\ndone"
                },
                {
                    "file": "tools/dreport.d/plugins.d/hoststate",
                    "line": 9,
                    "reviewer": {
                        "name": "Amithash Prasad",
                        "email": "amithash@meta.com",
                        "username": "amithash"
                    },
                    "message": "Done. I tested it out on both single and a multi-host servers to make sure I did not break anything."
                },
                {
                    "file": "tools/dreport.d/plugins.d/hoststate",
                    "line": 19,
                    "reviewer": {
                        "name": "Andrew Geissler",
                        "email": "geissonator@yahoo.com",
                        "username": "geissonator"
                    },
                    "message": "Could we make this 1-9 so we don't repeat the 0 instance we already captured above? Or if we want the file name to be consistent, just delete lines 10-17 and we'll capture everything in this loop."
                },
                {
                    "file": "tools/dreport.d/plugins.d/hoststate",
                    "line": 19,
                    "reviewer": {
                        "name": "Amithash Prasad",
                        "email": "amithash@meta.com",
                        "username": "amithash"
                    },
                    "message": "Thanks! I think this is the same recommendation as Jayanth's recommendation."
                }
            ],
