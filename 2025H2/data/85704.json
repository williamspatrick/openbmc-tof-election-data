                    },
                    "message": "Should add new parameter to doxygen"
                },
                {
                    "file": "phosphor-power-supply/chassis.hpp",
                    "line": 78,
                    "reviewer": {
                        "name": "Faisal Awada",
                        "email": "faisal@us.ibm.com",
