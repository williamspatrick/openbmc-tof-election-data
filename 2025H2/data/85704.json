                    "message": "Nit: ObjectManager path."
                },
                {
                    "file": "phosphor-power-supply/chassis.hpp",
                    "line": 236,
                    "reviewer": {
                        "name": "Faisal Awada",
                        "email": "faisal@us.ibm.com",
