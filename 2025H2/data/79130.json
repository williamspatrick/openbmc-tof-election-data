                    },
                    "message": "Try to avoid \"this commit\" - hopefully the message is about the commit it's written in \ud83d\ude0a\n\nThis can instead be:\n\n> Add `pldm_msgbuf_extract_uint8_to_size()`"
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 9,
                    "reviewer": {
                        "name": "ChauLy-Vietnam",
                        "email": "chaul@amperecomputing.com",
