                        "username": "vmauery"
                    },
                    "message": "```\nipmiSensorGetSdr(uint16_t reservationId, uint16_t recordId,\n                 uint8_t offset, uint8_t bytesToRead)\n```"
                },
                {
                    "file": "sensorhandler.cpp",
                    "line": 1334,
                    "reviewer": {
                        "name": "George Liu",
                        "email": "liuxiwei@ieisystem.com",
                        "username": "lxwinspur"
                    },
                    "message": "Acknowledged"
                },
                {
                    "file": "sensorhandler.cpp",
                    "line": 1336,
                    "reviewer": {
                        "name": "Vernon Mauery",
                        "email": "vernon.mauery@gmail.com",
                        "username": "vmauery"
                    },
                    "message": "just pass them around as individual variables; no need to package them up here. Putting them in a struct places a spatial requirement on the compiler when there is no need; it can just use registers if it wants or keep them on the stack or whatever optimizations it wants."
                },
                {
                    "file": "sensorhandler.cpp",
                    "line": 1336,
                    "reviewer": {
                        "name": "George Liu",
                        "email": "liuxiwei@ieisystem.com",
                        "username": "lxwinspur"
                    },
                    "message": "Acknowledged"
                },
                {
                    "file": "sensorhandler.cpp",
                    "line": 1403,
                    "reviewer": {
                        "name": "Vernon Mauery",
                        "email": "vernon.mauery@gmail.com",
                        "username": "vmauery"
                    },
                    "message": "same as above"
                },
                {
                    "file": "sensorhandler.cpp",
                    "line": 1403,
                    "reviewer": {
