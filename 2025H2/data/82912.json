                        "email": "liuxiwei@ieisystem.com",
                        "username": "lxwinspur"
                    },
                    "message": "Acknowledged"
                },
                {
                    "file": "sensorhandler.hpp",
                    "line": 78,
                    "reviewer": {
                        "name": "Vernon Mauery",
                        "email": "vernon.mauery@gmail.com",
                        "username": "vmauery"
                    },
                    "message": "no need to put this here; handlers don't call each other and are only called by the ipmi machinery after being registered. They could all be declared static, but usually are not."
                },
                {
                    "file": "sensorhandler.hpp",
                    "line": 78,
                    "reviewer": {
