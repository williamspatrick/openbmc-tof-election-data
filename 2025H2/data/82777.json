                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "You could use\n\"--http2\",\naction=argparse.BooleanOptionalAction\n\nhere and support both\n--http2 and --no-http2 args at the same time.  It's a style thing, up to you if you want to change."
                },
