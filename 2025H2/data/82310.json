            "comments": [
                {
                    "file": "schemas/valve.json",
                    "line": 15,
                    "reviewer": {
                        "name": "Alexander",
                        "email": "alexander.hansen@9elements.com",
                        "username": "pointbazaar"
                    },
                    "message": "i would suggest Type `ValveStatus`, `ValveStatusInput` or `GPIOValveStatus` unless that's already fixed by the design.\n\nThe idea is to enhance readability without having the schema at hand.\n\nFor example in the following record, it is unclear if an input or output (gpio based valve control) has been implemented.\n\n```json\n{\n   \"Name\": \"VM1\",\n   \"PinName\": \"VALVE_GPIO_8\",\n   \"Polarity\": \"High\",\n   \"Type\": \"GPIOValve\"\n}\n```"
                },
                {
                    "file": "schemas/valve.json",
                    "line": 15,
                    "reviewer": {
                        "name": "Jagpal S Gill",
                        "email": "paligill@gmail.com",
                        "username": "jagpalgill"
                    },
                    "message": "I have updated the PinName and Polarity to StatusPinName and StatusPolarity to reflect their intended purpose. Thanks"
                }
            ],
