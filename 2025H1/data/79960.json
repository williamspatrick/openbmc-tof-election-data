                    "line": 12,
                    "reviewer": {
                        "name": "Fred Chen",
                        "email": "Fred.Chen@quantatw.com",
                        "username": "fredchenquanta"
                    },
                    "message": "Thank you for the reminder. I missed that. It seems this patch already includes it.\nhttps://gerrit.openbmc.org/c/openbmc/phosphor-dbus-interfaces/+/80728"
                },
                {
                    "file": "meta-facebook/meta-santabarbara/conf/machine/santabarbara.conf",
                    "line": 12,
                    "reviewer": {
                        "name": "Patrick Williams",
