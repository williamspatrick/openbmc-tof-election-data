        {
            "number": 5,
            "revision": "e17e08a8d5a72145aadbebf00fe9a4a10a668a67",
            "parents": [
                "b8e44e8c9ccff5dcc2e0a8ac404ca0f3a3902dc1"
            ],
            "ref": "refs/changes/40/77440/5",
            "uploader": {
                "name": "Alexander",
                "email": "alexander.hansen@9elements.com",
                "username": "pointbazaar"
            },
            "createdOn": 1741684604,
            "author": {
                "name": "Alexander",
                "email": "alexander.hansen@9elements.com",
                "username": "pointbazaar"
            },
            "kind": "REWORK",
            "comments": [
                {
                    "file": "tools/sdbusplus/property.py",
                    "line": 59,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "I don't really like this manipulation.  This isn't really the default value.  I'd rather we handle this in the mako template for cases that we need to emit something (like {}).\n\nAs written you've effectively inserted this magic value here and then in the mako you have to check for this magic value.  Let's just avoid the magic value and emit the desired template."
                },
                {
                    "file": "tools/sdbusplus/property.py",
                    "line": 59,
                    "reviewer": {
                        "name": "Alexander",
                        "email": "alexander.hansen@9elements.com",
                        "username": "pointbazaar"
                    },
                    "message": "Removed it and did this a different way.\n\n'aserver' and 'server' declare their properties with different way and i did not see that before. Cleaning that up simplified things a lot."
                },
                {
                    "file": "tools/sdbusplus/property.py",
                    "line": 59,
                    "reviewer": {
                        "name": "Alexander",
                        "email": "alexander.hansen@9elements.com",
                        "username": "pointbazaar"
                    },
                    "message": "Done"
                },
                {
                    "file": "tools/sdbusplus/templates/property.aserver.callback.hpp.mako",
                    "line": 19,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "It's not obvious how this is related to this commit."
                },
                {
                    "file": "tools/sdbusplus/templates/property.aserver.callback.hpp.mako",
                    "line": 19,
                    "reviewer": {
                        "name": "Alexander",
                        "email": "alexander.hansen@9elements.com",
                        "username": "pointbazaar"
                    },
                    "message": "The compiler can get confused since the example is also in 'server' namespace.\nFully qualifying the name helps to avoid these problems.\n\nShould i break that out into a separate patch?"
                },
                {
                    "file": "tools/sdbusplus/templates/property.aserver.callback.hpp.mako",
                    "line": 19,
                    "reviewer": {
                        "name": "Patrick Williams",
