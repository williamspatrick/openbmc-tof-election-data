                {
                    "file": "pldmtool/pldm_cmd_helper.cpp",
                    "line": 83,
                    "reviewer": {
                        "name": "Rajeev Ranjan",
                        "email": "ranjan.rajeev1609@gmail.com",
                        "username": "rajeeranjan"
                    },
                    "message": "Error codes from base spec is already taken care above, now if completion code is not found in the map-> data[\"CompletionCode\"] = \"UNKNOWN_COMPLETION_CODE\";\n\nExpectation is to use fillCompletionCode() for other types after adding the logic here, otherwise it will be marked as UNKNOWN_COMPLETION_CODE"
                },
                {
