            "comments": [
                {
                    "file": "/COMMIT_MSG",
                    "line": 7,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Why not Common.File?  I don't see a reason to make a new top-level directory for one interface and \".Object\" isn't really a useful part of the name."
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 7,
                    "reviewer": {
                        "name": "ChauLy-Vietnam",
                        "email": "chaul@amperecomputing.com",
