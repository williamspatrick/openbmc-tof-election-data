                    "file": "src/ssl_key_handler.cpp",
                    "line": 562,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "I'd rather not tie to this option, because this has nothing to do with TLS name parsing.  Let just make a new option"
