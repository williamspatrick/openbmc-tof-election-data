            "kind": "REWORK",
            "comments": [
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "I'd like to see this code reworked.  I'm going to merge it as-is due to release build timelines, but please improve on what is here."
                },
                {
                    "file": "meta-facebook/meta-ventura/recipes-phosphor/gpio/phosphor-gpio-monitor/frontled",
                    "line": 11,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "This code is really unreadable."
                },
                {
                    "file": "meta-facebook/meta-ventura/recipes-phosphor/gpio/phosphor-gpio-monitor/frontled",
                    "line": 21,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "We need to start moving away from \"compute card\" and \"switch blade\" (or \"nvs\") kind of notation.  By using this notation you're tailoring ventura to a particular system implementation (Catalina) but we're going to reuse the Ventura RMC on many other system designs.  Those designs will not have \"nvs\" attached to them.\n\nWe need to move towards labeling these as generic leak tray ports."
                },
                {
                    "file": "meta-facebook/meta-ventura/recipes-phosphor/gpio/phosphor-gpio-monitor/led-amber-assert@.service",
                    "line": 5,
                    "reviewer": {
                        "name": "Jagpal S Gill",
                        "email": "paligill@gmail.com",
                        "username": "jagpalgill"
                    },
                    "message": "I don't see the last two args being used in frontled?\n\nAlso isn't it better to pass tray and assert/deassert as 2 different args to frontled rather than passing as string and doing the cut logic in handler?"
                }
            ],
