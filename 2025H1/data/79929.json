            "comments": [
                {
                    "file": "meta-facebook/meta-catalina/recipes-catalina/plat-svc/files/iob-nic-temp-read",
                    "line": 152,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Why can't we do this as part of the power cycle handling?  Using a temp file to handshake between two services is not ideal.  I'd rather restart the service as part of the host boot sequence (see phosphor-state-manager targets)."
                },
                {
                    "file": "meta-facebook/meta-catalina/recipes-phosphor/gpio/phosphor-gpio-monitor/catalina-gpio-monitor",
                    "line": 55,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Please use files in /run.  If you look at phosphor-state-manager, they expect files to be created in /run in order to exempt running certain phosphor-state-manager steps on BMC reboots.  Is this something we should be leveraging here?"
                }
            ],
