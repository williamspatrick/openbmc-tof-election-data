            "kind": "TRIVIAL_REBASE",
            "comments": [
                {
                    "file": "configurations/meta/minerva_fanboard.json",
                    "line": 0,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Please rename this file appropriately.  Otherwise we have no idea what the difference between this \"base\" one and the \"second source\" one is."
                },
                {
                    "file": "configurations/meta/minerva_fanboard.json",
                    "line": 0,
                    "reviewer": {
                        "name": "Yang Chen",
                        "email": "yang.chen@quantatw.com",
                        "username": "Quanta-YangChen"
                    },
                    "message": "Done"
                },
                {
                    "file": "configurations/meta/minerva_fanboard.json",
                    "line": 447,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Can we get added to the product name the differentiation?  This is what we've done in all the Yv4 config files.\n\nHaving to specify these as part numbers means that for each development phase we have to add new entries, right?"
                },
                {
                    "file": "configurations/meta/minerva_fanboard.json",
                    "line": 447,
                    "reviewer": {
                        "name": "Yang Chen",
                        "email": "yang.chen@quantatw.com",
                        "username": "Quanta-YangChen"
                    },
                    "message": "Due to the FRU format already defined on the Minerva system (Harma and Minerva), we may not change the product name. Unlike YV4, we use the board custom data 4 fields to distinguish the different sources of the board. Board custom data 4 will start from the next stage (PVT) so I put the probe condition \"BOARD_PART_NUMBER\" here to downward compatibility with the old stage version."
                }
            ],
