                    "line": 171,
                    "reviewer": {
                        "name": "Vernon Mauery",
                        "email": "vernon.mauery@gmail.com",
                        "username": "vmauery"
                    },
                    "message": "This method used to throw on error. Now it needs to return a boost::system::error_code"
                },
