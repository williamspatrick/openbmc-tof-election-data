                    },
                    "message": "This looks suspect."
                },
                {
                    "file": "meta-phosphor/recipes-kernel/linux/cgroup/cgroup.cfg",
                    "line": 15,
                    "reviewer": {
                        "name": "James Athappilly",
                        "email": "jamesatha@meta.com",
                        "username": "jamesatha"
                    },
                    "message": "This was required to enable CONFIG_BLK_CGROUP_PUNT_BIO"
                },
                {
                    "file": "meta-phosphor/recipes-kernel/linux/cgroup/cgroup.cfg",
                    "line": 15,
                    "reviewer": {
                        "name": "Amithash Prasad",
                        "email": "amithash@meta.com",
                        "username": "amithash"
                    },
                    "message": "Acknowledged"
                },
                {
                    "file": "meta-phosphor/recipes-kernel/linux/cgroup/cgroup.cfg",
                    "line": 15,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "> This was required to enable CONFIG_BLK_CGROUP_PUNT_BIO\n\nThis is not true.  You have it backwards.  BTRFS requires BLK_CGROUP_PUNT_BIO not the other way around.\n\nhttps://github.com/openbmc/linux/blob/840d9a813c8eaa5c55d86525e374a97ca5023b53/fs/btrfs/Kconfig#L5\nhttps://github.com/openbmc/linux/blob/840d9a813c8eaa5c55d86525e374a97ca5023b53/block/Kconfig#L45\n\nWe shouldn't be enabling BTRFS here."
                },
                {
                    "file": "meta-phosphor/recipes-kernel/linux/cgroup/cgroup.cfg",
                    "line": 15,
                    "reviewer": {
                        "name": "James Athappilly",
                        "email": "jamesatha@meta.com",
                        "username": "jamesatha"
                    },
                    "message": "I have removed this but for reasons I cannot explain CONFIG_BLK_CGROUP_PUNT_BIO silently is dropped which is fine for us"
                },
                {
                    "file": "meta-phosphor/recipes-kernel/linux/cgroup/cgroup.cfg",
                    "line": 22,
                    "reviewer": {
                        "name": "Amithash Prasad",
                        "email": "amithash@meta.com",
                        "username": "amithash"
                    },
                    "message": "Is this needed?"
                },
                {
                    "file": "meta-phosphor/recipes-kernel/linux/cgroup/cgroup.cfg",
                    "line": 22,
                    "reviewer": {
                        "name": "James Athappilly",
                        "email": "jamesatha@meta.com",
                        "username": "jamesatha"
                    },
                    "message": "CONFIG_DEBUG_CGROUP_REF"
                },
                {
                    "file": "meta-phosphor/recipes-kernel/linux/cgroup/cgroup.cfg",
                    "line": 22,
                    "reviewer": {
                        "name": "James Athappilly",
                        "email": "jamesatha@meta.com",
                        "username": "jamesatha"
                    },
                    "message": "This was needed for CONFIG_DEBUG_CGROUP_REF"
                },
                {
                    "file": "meta-phosphor/recipes-kernel/linux/cgroup/cgroup.cfg",
                    "line": 22,
                    "reviewer": {
                        "name": "Amithash Prasad",
                        "email": "amithash@meta.com",
                        "username": "amithash"
                    },
                    "message": "Acknowledged"
                },
                {
                    "file": "meta-phosphor/recipes-kernel/linux/cgroup/cgroup.cfg",
