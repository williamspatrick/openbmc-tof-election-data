            "comments": [
                {
                    "file": ".clang-tidy",
                    "line": 81,
                    "reviewer": {
                        "name": "ManojKiran Eda",
                        "email": "manojkiran.eda@gmail.com",
                        "username": "manojkiraneda"
                    },
                    "message": "do we need `c` checks here ? pldm code base is entirely a c++ project right ? is it not an overkill ?"
                },
                {
                    "file": ".clang-tidy",
                    "line": 81,
                    "reviewer": {
                        "name": "Pavithra Barithaya",
                        "email": "pavithrabarithaya07@gmail.com",
                        "username": "Pavithrab7"
                    },
                    "message": "yes, it's a C-style check but in some places I see it's mentioned it is applicable for C++ as well.\n\nExample: CERT C Coding Standard (cert-con36-c) focuses on safe type conversions in C, and its principles are also applicable to C++.\n\nI can remove them if it's not preferred."
                },
                {
                    "file": ".clang-tidy",
                    "line": 81,
                    "reviewer": {
                        "name": "Pavithra Barithaya",
                        "email": "pavithrabarithaya07@gmail.com",
                        "username": "Pavithrab7"
                    },
                    "message": "I verified the C-checks added, it mentioned that these checks have been incorporated in some related C++ checks. So I believe even if we remove these C checks we will be incorporating same functionality check in other C++ checks."
                },
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Thu Nguyen",
                        "email": "thu@os.amperecomputing.com",
                        "username": "ThuBaNguyen"
                    },
                    "message": "LGTM."
                }
            ],
