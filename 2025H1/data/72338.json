                    "reviewer": {
                        "name": "Archana Kakani",
                        "email": "archana.kakani@ibm.com",
                        "username": "ArchanaKakani"
                    },
                    "message": "Those traces will convey the details about PDR exchange happened with the remote terminus. This information helps developer to map the sequence of operation during Host Power on."
                }
