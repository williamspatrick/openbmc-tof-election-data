                    "reviewer": {
                        "name": "Deepak Kamat",
                        "email": "deepakkamat6630@gmail.com",
                        "username": "dkamat27"
                    },
                    "message": "added the size and time also not seeing any significant performance impact. it is 15sec on qemuarm for the dump creation and 0.015s time took by plugin command."
                },
