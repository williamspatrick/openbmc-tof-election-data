            "comments": [
                {
                    "file": "vpd-manager/include/constants.hpp",
                    "line": 240,
                    "reviewer": {
                        "name": "priyaram",
                        "email": "priyangaramasamy2@gmail.com",
                        "username": "PriyangaRamasamy"
                    },
                    "message": "how can you gaurantee that IM value will always be present in this offset only?\n\nwhat if a new record gets added to the VPD like how we added VSBK in base panel VPD?"
                },
                {
                    "file": "vpd-manager/include/constants.hpp",
                    "line": 240,
                    "reviewer": {
                        "name": "Anupama B R",
                        "email": "anupama.b.r1@ibm.com",
                        "username": "branupama"
                    },
                    "message": "System VPD gets update very rarely, the requirement is to directly read IM value from its offset.\nIn future if offset changes, we should update this offset. so will handle this later when system VPD gets updated."
                },
                {
                    "file": "vpd-manager/include/constants.hpp",
                    "line": 240,
                    "reviewer": {
                        "name": "SunnySrivastava",
                        "email": "sunnsr25@in.ibm.com",
                        "username": "SunnySrivastava1984"
                    },
                    "message": "I don't agree with this explanation that in case anything changes, code breaks then we come back and fix the code.\nIdeally a code should be flexible enough to deal with any external factor changes."
                },
                {
                    "file": "vpd-manager/include/constants.hpp",
                    "line": 240,
                    "reviewer": {
                        "name": "Anupama B R",
                        "email": "anupama.b.r1@ibm.com",
                        "username": "branupama"
                    },
                    "message": "This is test code, will be removed later."
                },
                {
                    "file": "vpd-manager/include/constants.hpp",
                    "line": 240,
                    "reviewer": {
                        "name": "SunnySrivastava",
                        "email": "sunnsr25@in.ibm.com",
                        "username": "SunnySrivastava1984"
                    },
                    "message": "Acknowledged"
                },
                {
