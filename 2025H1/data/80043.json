            "comments": [
                {
                    "file": "common/include/utils.hpp",
                    "line": 11,
                    "reviewer": {
                        "name": "Jagpal S Gill",
                        "email": "paligill@gmail.com",
                        "username": "jagpalgill"
                    },
                    "message": "I am wondering if returning the int status will be useful in any way. In the callers i see only the pass/fail is being checked and if thats true wouldn't it be better to change the return status to bool?"
                },
                {
                    "file": "common/include/utils.hpp",
                    "line": 11,
                    "reviewer": {
                        "name": "11110128-KevinTung",
                        "email": "kevin.wtmh@gmail.com",
                        "username": "kevintungquanta"
                    },
                    "message": "Improved the implementation to return the actual exitCode of the child process, rather than just indicating pass/fail. The return type remains int."
                },
                {
                    "file": "common/include/utils.hpp",
                    "line": 11,
                    "reviewer": {
                        "name": "Jagpal S Gill",
                        "email": "paligill@gmail.com",
                        "username": "jagpalgill"
                    },
                    "message": "@Kevin.Tung@quantatw.com Sorry there is some misunderstanding. My point was to return pass and fail as a bool as i don't see the child exit status useful to the caller. Lets do the exit status handling in the asyncSystem() and just return pass and fail as bool."
                },
                {
                    "file": "common/include/utils.hpp",
                    "line": 11,
                    "reviewer": {
                        "name": "11110128-KevinTung",
                        "email": "kevin.wtmh@gmail.com",
                        "username": "kevintungquanta"
                    },
                    "message": "Understood. The return type has been updated to bool as suggested."
                },
                {
                    "file": "common/src/utils.cpp",
                    "line": 3,
