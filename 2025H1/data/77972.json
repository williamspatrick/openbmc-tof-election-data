                    "file": "http/utility.hpp",
                    "line": 241,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "Constexpr by definition is evaluated at compile time, so I don't think it will be invoked multiple, but sure, just for clarity in the code, I can add it."
                }
