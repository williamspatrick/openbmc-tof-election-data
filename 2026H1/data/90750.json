        {
            "number": 4,
            "revision": "4dabab75ca7a0eca066dbe2cfe61ec22b122ecc1",
            "parents": [
                "e2cf2ef22b8beda53643c01b5589760900e42ad9"
            ],
            "ref": "refs/changes/50/90750/4",
            "uploader": {
                "name": "Alexander",
                "email": "alexander.hansen@9elements.com",
                "username": "pointbazaar"
            },
            "createdOn": 1783605828,
            "author": {
                "name": "Alexander",
                "email": "alexander.hansen@9elements.com",
                "username": "pointbazaar"
            },
            "kind": "REWORK",
            "comments": [
                {
                    "file": "yaml/xyz/openbmc_project/ObjectMapper.interface.yaml",
                    "line": 256,
                    "reviewer": {
                        "name": "Matt Spinler",
                        "email": "spinler@us.ibm.com",
                        "username": "spinler"
                    },
                    "message": "How would sourcePath/sourceInterfaces and then targetPath/targetInterfaces sound?\n\nJust trying to think of something more meaningful than '1' and '2' to distinguish them, and this is all I came up with.\n\nIf you don't like, can close."
                },
                {
                    "file": "yaml/xyz/openbmc_project/ObjectMapper.interface.yaml",
                    "line": 256,
                    "reviewer": {
                        "name": "Alexander",
                        "email": "alexander.hansen@9elements.com",
                        "username": "pointbazaar"
                    },
                    "message": "Agree the naming `reqPath1` is weird and probably needs changed.\n\nI don't want to introduce new terminology into the mapper as we already have 'forward', 'reverse', association owner, association definition, subtree, subtree paths, depth, endpoints, ...\n\nwhich has been sufficient for me to discuss these things without introducing 'source' and 'target' concept.\n\nended up renaming it to `subtreePath1`, to be somewhat in line with how the other mapper calls named it. (noticing that we also have alias subtree path for namespace paths in PDI)"
                }
            ],
