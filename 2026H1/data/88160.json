    "patchSets": [
        {
            "number": 1,
            "revision": "1f3be904946f4614fa7e2633bf7b7c8db09fb138",
            "parents": [
                "3203b75ee562371731505ba4c4adf0ac6bb59be6"
            ],
            "ref": "refs/changes/60/88160/1",
            "uploader": {
                "name": "Harshit Aghera",
                "email": "haghera@nvidia.com",
                "username": "harshit-aghera"
            },
            "createdOn": 1773132546,
            "author": {
                "name": "Harshit Aghera",
                "email": "haghera@nvidia.com",
                "username": "harshit-aghera"
            },
            "kind": "REWORK",
            "comments": [
                {
                    "file": "src/nvidia-gpu/NvidiaGpuCurrentUtilization.cpp",
                    "line": 88,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "This only handles ACCEPTED (0x7D). \nIf the GPU responds directly with SUCCESS (0x00) and the actual data (which the spec allows \u2014 long-running commands may complete immediately), the response should  handle the SUCCESS case by decoding the response data directly without going through the long-running event path."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuCurrentUtilization.cpp",
                    "line": 88,
                    "reviewer": {
                        "name": "Harshit Aghera",
                        "email": "haghera@nvidia.com",
                        "username": "harshit-aghera"
                    },
                    "message": "Done"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuCurrentUtilization.cpp",
                    "line": 130,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "The spec for Get Current Utilization (Type 3 cmd 0x47) defines two fields in the response: GPU Utilization (NvU32) + Memory Utilization (NvU32) = 8 bytes. Should the size check be < 8 to match the spec?"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuCurrentUtilization.cpp",
                    "line": 130,
                    "reviewer": {
                        "name": "Harshit Aghera",
                        "email": "haghera@nvidia.com",
                        "username": "harshit-aghera"
                    },
                    "message": "Done"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuCurrentUtilization.cpp",
                    "line": 141,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "Consider using le32toh() here for consistency:  \nstd::memcpy(&utilization, responseData.data(), sizeof(uint32_t));\nutilization = le32toh(utilization);"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuCurrentUtilization.cpp",
                    "line": 141,
                    "reviewer": {
                        "name": "Harshit Aghera",
                        "email": "haghera@nvidia.com",
                        "username": "harshit-aghera"
                    },
                    "message": "Done"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuDevice.cpp",
                    "line": 75,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "Utilization is not defined in the upstream PDI for xyz.openbmc_project.Inventory.Item.Cpu.OperatingConfig (OperatingConfig.interface.yaml).\nhttps://github.com/openbmc/phosphor-dbus-interfaces/blob/master/yaml/xyz/openbmc_project/Inventory/Item/Cpu/OperatingConfig.interface.yaml"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuDevice.cpp",
                    "line": 75,
                    "reviewer": {
                        "name": "Harshit Aghera",
                        "email": "haghera@nvidia.com",
                        "username": "harshit-aghera"
                    },
                    "message": "Updated the commit message with needed PDI patch."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuDevice.cpp",
                    "line": 83,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "If operatingConfigInterface fails to initialize, this early return skips makeSensors() and eventReporting->init(), so the entire GPU device will have no temperature, power, voltage sensors, and no event subscription. The utilization interface failure should not prevent critical sensors from being created. \nConsider continuing without it on failure instead of returning."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuDevice.cpp",
                    "line": 83,
                    "reviewer": {
                        "name": "Harshit Aghera",
                        "email": "haghera@nvidia.com",
                        "username": "harshit-aghera"
                    },
                    "message": "Done"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuDevice.cpp",
                    "line": 266,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "Suggestion: currentUtilization->update() is called every poll cycle (default 1 second), but TTIMEOUT_LONG in the spec is also 1 second. If the long-running event doesn't come back before the next poll, registerResponseHandler will return EEXIST and the response is lost.\n\nConsider giving long-running commands a separate, longer polling interval instead of sharing the same cycle as regular sensors, or skipping update() if a previous request is still pending."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuDevice.cpp",
                    "line": 266,
                    "reviewer": {
                        "name": "Harshit Aghera",
                        "email": "haghera@nvidia.com",
                        "username": "harshit-aghera"
                    },
                    "message": "This will be taken care in separate follow up patch, to place all long-running commands in separate round-robin queue."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuDevice.cpp",
                    "line": 266,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "Got it."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuMctpVdm.cpp",
                    "line": 208,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "nit: Same pattern as the decodeEvent subspan issue in the parent patch (84679). \nIf 84679 fixes decodeEvent to use subspan(eventHeaderSize, size), this will be fine."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuMctpVdm.cpp",
                    "line": 208,
                    "reviewer": {
                        "name": "Harshit Aghera",
                        "email": "haghera@nvidia.com",
                        "username": "harshit-aghera"
                    },
                    "message": "Done"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaLongRunningHandler.hpp",
                    "line": 34,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "nit: Could the tuple fields have comments for readability?\nusing ResponseKey = std::tuple<gpu::MessageType, uint8_t /*commandCode*/>;"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaLongRunningHandler.hpp",
                    "line": 34,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "The key is (MessageType, CommandCode), which means only one pending long-running request per command type is supported. If the  same command is sent twice (e.g., from polling), the second registerResponseHandler fails with EEXIST. Consider adding instanceId to the key:\nusing ResponseKey = std::tuple<gpu::MessageType, uint8_t /*commandCode*/, uint8_t /*instanceId*/>;\nThe instanceId is available in the long-running event payload (decoded by decodeLongRunningResponseEvent), so the handler can\n  still match it on the event side. This would allow multiple concurrent long-running requests for the same command to coexist."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaLongRunningHandler.hpp",
                    "line": 34,
                    "reviewer": {
                        "name": "Harshit Aghera",
                        "email": "haghera@nvidia.com",
                        "username": "harshit-aghera"
                    },
                    "message": "Done"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaLongRunningHandler.hpp",
                    "line": 34,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "Code looks good overall. One question: the ResponseKey is still (MessageType, commandCode) without instanceId. Was this intentionally deferred to the round-robin queue follow-up patch?"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaLongRunningHandler.hpp",
                    "line": 34,
                    "reviewer": {
                        "name": "Harshit Aghera",
                        "email": "haghera@nvidia.com",
                        "username": "harshit-aghera"
                    },
                    "message": "With the round-robin queue follow-up patch, polling loop will not call update function of the Long-running command classes without waiting for the response of the previous command. So there always will be only one pending long-running request with the device."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaLongRunningHandler.hpp",
                    "line": 34,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "Okay, got it. Waiting for PDI."
                }
            ],
