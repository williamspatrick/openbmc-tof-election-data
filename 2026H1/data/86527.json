            "comments": [
                {
                    "file": "/COMMIT_MSG",
                    "line": 10,
                    "reviewer": {
                        "name": "Ravi Teja",
                        "email": "raviteja28031990@gmail.com",
                        "username": "raviteja-b"
                    },
                    "message": "do you see any issue in network config if static\nIPv6 gateway address that is identical to an assigned local IPv6 IP?"
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 10,
                    "reviewer": {
                        "name": "rashidmp",
                        "email": "rashidmp@ami.com",
                        "username": "rashidmp2002"
                    },
                    "message": "Yes, I have observed an issue. When the static IPv6 gateway is configured to the same address as one of the local IPv6 addresses, systemd\u2011networkd refuses to apply the route. The journal logs the following error:\n\"Could not set static route: Gateway can not be a local address. Invalid argument.\"\nBecause of this failure, the existing IPv6 default gateway gets removed and no new default gateway is added."
                },
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "rashidmp",
                        "email": "rashidmp@ami.com",
                        "username": "rashidmp2002"
                    },
                    "message": "Addressed comments."
                },
                {
                    "file": "src/ethernet_interface.cpp",
                    "line": 453,
                    "reviewer": {
                        "name": "Ravi Teja",
                        "email": "raviteja28031990@gmail.com",
                        "username": "raviteja-b"
                    },
                    "message": "why dont we do apply same check for IPv6 addresses?"
                },
                {
                    "file": "src/ethernet_interface.cpp",
                    "line": 453,
                    "reviewer": {
                        "name": "rashidmp",
                        "email": "rashidmp@ami.com",
                        "username": "rashidmp2002"
                    },
                    "message": "Updated"
                }
