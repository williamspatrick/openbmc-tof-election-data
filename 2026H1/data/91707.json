        {
            "number": 2,
            "revision": "5333274bd3333cafdaf323e24202d0d83c363ab4",
            "parents": [
                "4032853c0b71f6b5ef64057c095e1720b3afe7ec"
            ],
            "ref": "refs/changes/07/91707/2",
            "uploader": {
                "name": "Nagavarapu Sai Pavan",
                "email": "saipavann@ami.com",
                "username": "saipavann27"
            },
            "createdOn": 1782372095,
            "author": {
                "name": "Nagavarapu Sai Pavan",
                "email": "saipavann@ami.com",
                "username": "saipavann27"
            },
            "kind": "REWORK",
            "comments": [
                {
                    "file": "apphandler.cpp",
                    "line": 1520,
                    "reviewer": {
                        "name": "Vernon Mauery",
                        "email": "vernon.mauery@gmail.com",
                        "username": "vmauery"
                    },
                    "message": "not all of the parameters are required to have a 16-byte field. Also, given that the behavior is already more lenient, I hesitate to change it to be more strict because tools and users may be expecting the behavior to match the current behavior. The lengths are checked, so there is not a security issue."
                },
                {
                    "file": "apphandler.cpp",
                    "line": 1520,
                    "reviewer": {
                        "name": "Nagavarapu Sai Pavan",
                        "email": "saipavann@ami.com",
                        "username": "saipavann27"
                    },
                    "message": "Length validation: Changed from strict equality check to lenient\n   behavior. Accept payloads < 16 bytes (zero-padded for backward\n   compatibility) and reject only oversized payloads > 16 bytes. This\n   maintains expected behavior for existing tools and users."
                },
                {
                    "file": "apphandler.cpp",
                    "line": 1520,
                    "reviewer": {
                        "name": "Nagavarapu Sai Pavan",
                        "email": "saipavann@ami.com",
                        "username": "saipavann27"
                    },
                    "message": "Done"
                },
                {
                    "file": "apphandler.cpp",
                    "line": 1553,
                    "reviewer": {
                        "name": "Vernon Mauery",
                        "email": "vernon.mauery@gmail.com",
                        "username": "vmauery"
                    },
                    "message": "encoding should not be global; it is a per-parameter option. So if we are changing it, we should change it in the data storage so that along with each string, we store the encoding as well."
                },
                {
                    "file": "apphandler.cpp",
                    "line": 1553,
                    "reviewer": {
                        "name": "Nagavarapu Sai Pavan",
                        "email": "saipavann@ami.com",
                        "username": "saipavann27"
                    },
                    "message": "Removed global encoding variable and\n   implemented per-parameter encoding storage using std::map in\n   SysInfoParamStore. Each parameter now has independent encoding\n   value, preventing data isolation issues."
                },
                {
                    "file": "apphandler.cpp",
                    "line": 1553,
                    "reviewer": {
                        "name": "Nagavarapu Sai Pavan",
                        "email": "saipavann@ami.com",
                        "username": "saipavann27"
                    },
                    "message": "Done"
                }
            ],
