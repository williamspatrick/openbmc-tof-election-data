                    "file": "meta-facebook/recipes-extended/rsyslog/rsyslog/rsyslog-oob-console.conf.in",
                    "line": 3,
                    "reviewer": {
                        "name": "PeterYinGit",
                        "email": "peter.yin@quantatw.com",
                        "username": "PeterYinGit"
                    },
                    "message": "Since /var/spool/rsyslog is a persistent partition, should we consider moving the logs and state files to tmpfs to avoid frequent write operations."
                },
                {
                    "file": "meta-facebook/recipes-extended/rsyslog/rsyslog/rsyslog-oob-console.conf.in",
