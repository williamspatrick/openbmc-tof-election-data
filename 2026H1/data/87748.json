                    "file": "schemas/legacy.json",
                    "line": 1188,
                    "reviewer": {
                        "name": "Alexander",
                        "email": "alexander.hansen@9elements.com",
                        "username": "pointbazaar"
                    },
                    "message": "Let's add a small description as to what this property is used for. You will probably know better what to write here, below is just my initial draft.\n\n```suggestion\n                    \"LED\": {\n                        \"description\": \"Name of LED Group to assert on lower critical threshold event\",\n                        \"type\": \"string\"\n                    }\n```"
                },
                {
                    "file": "schemas/legacy.json",
                    "line": 1188,
                    "reviewer": {
                        "name": "ChauLy-Vietnam",
                        "email": "chaul@amperecomputing.com",
