    "patchSets": [
        {
            "number": 1,
            "revision": "80345470d83577f71844dfeb8c390f32fada1524",
            "parents": [
                "f8ad7f13279b8fe92ec2568feb047ff96e1d5cc2"
            ],
            "ref": "refs/changes/96/89096/1",
            "uploader": {
                "name": "Janet Adkins",
                "email": "janeta@us.ibm.com",
                "username": "jeaaustx"
            },
            "createdOn": 1775761951,
            "author": {
                "name": "Janet Adkins",
                "email": "janeta@us.ibm.com",
                "username": "jeaaustx"
            },
            "kind": "REWORK",
            "comments": [
                {
                    "file": "/COMMIT_MSG",
                    "line": 7,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Wasn't there a design document about audit that was never resolved.  Can we write down what is being accomplished by these recipes?"
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 7,
                    "reviewer": {
                        "name": "Janet Adkins",
                        "email": "janeta@us.ibm.com",
                        "username": "jeaaustx"
                    },
                    "message": "IBM's distribution is using linux audit downstream. Some amount of recipe work was required to get this enabled. The goal with this commit is to share the recipe work for other distributions which might also find it helpful.\n\nIBM carries other downstream patches which enable audit entries. This commit does not include those patches.\n\nYes there is an audit design document. One was merged a long time ago but never implemented.[1] It is not specific to linux audit. I realize the use of phosphor-audit by this commit could be confusing. I've renamed to linux-audit and renamed the DISTRO_FEATURE to df-linux-audit to avoid the confusion.\n\nI've also updated the commit message to add a \"why\" statement for this particular commit.\n\n[1] https://github.com/openbmc/docs/blob/master/designs/phosphor-audit.md"
                },
                {
                    "file": "meta-ibm/recipes-phosphor/images/obmc-phosphor-image.bbappend",
                    "line": 66,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Why would this part be unique to IBM?"
                },
                {
                    "file": "meta-ibm/recipes-phosphor/images/obmc-phosphor-image.bbappend",
                    "line": 66,
                    "reviewer": {
                        "name": "Janet Adkins",
                        "email": "janeta@us.ibm.com",
                        "username": "jeaaustx"
                    },
                    "message": "You are right, since this is under DISTRO_FEATURES control it makes sense for it to be in a common location. I've uncommented it in the phosphor-audit.inc file and removed from here.\n\nI rebuilt an image using just the (renamed) linux-audit.inc file and confirmed auditd and other user utilities were successfully installed."
                },
                {
                    "file": "meta-phosphor/recipes-security/audit/audit_%.bbappend",
                    "line": 12,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Why wouldn't we put the proposed defaults here?"
                },
                {
                    "file": "meta-phosphor/recipes-security/audit/audit_%.bbappend",
                    "line": 12,
                    "reviewer": {
                        "name": "Janet Adkins",
                        "email": "janeta@us.ibm.com",
                        "username": "jeaaustx"
                    },
                    "message": "The upstream layer defines defaults. (https://github.com/linux-audit/audit-userspace/blob/master/init.d/auditd.conf) I've added a comment here to try to clarify this.\n\nSo if no changes are made the flash image will get the upstream layer defaults. There are many other configuration values which could be changed. I've only included ones here that IBM is currently modifying from the defaults. These could be expanded to include other configuration values which other distributions might want to modify as well."
                },
                {
                    "file": "meta-phosphor/recipes-security/audit/audit_%.bbappend",
                    "line": 15,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "I don't really like \"NO_...\" variables.  Just make it \"AUDIT_JOURNAL\" and default to 1?"
                },
                {
                    "file": "meta-phosphor/recipes-security/audit/audit_%.bbappend",
                    "line": 15,
                    "reviewer": {
                        "name": "Janet Adkins",
                        "email": "janeta@us.ibm.com",
                        "username": "jeaaustx"
                    },
                    "message": "Done"
                },
                {
                    "file": "meta-phosphor/recipes-security/audit/audit_%.bbappend",
                    "line": 43,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Please clean up stray whitespace."
                },
                {
                    "file": "meta-phosphor/recipes-security/audit/audit_%.bbappend",
                    "line": 43,
                    "reviewer": {
                        "name": "Janet Adkins",
                        "email": "janeta@us.ibm.com",
                        "username": "jeaaustx"
                    },
                    "message": "I guess there isn't a CI check for those in this repo. I've cleaned them up."
                }
            ],
