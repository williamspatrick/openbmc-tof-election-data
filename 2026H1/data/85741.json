                    "line": 218,
                    "reviewer": {
                        "name": "Deepak Kodihalli",
                        "email": "deepak.kodihalli.83@gmail.com",
                        "username": "dkodihal"
                    },
                    "message": "Do we really need to update this periodically or can it go to ivnentory.cpp?"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuDevice.cpp",
                    "line": 218,
                    "reviewer": {
                        "name": "Harshit Aghera",
                        "email": "haghera@nvidia.com",
                        "username": "harshit-aghera"
                    },
                    "message": "Yes, it can change from in-band after boot and hence we have to update it periodically."
                }
