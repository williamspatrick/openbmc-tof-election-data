                {
                    "file": "/COMMIT_MSG",
                    "line": 13,
                    "reviewer": {
                        "name": "Deepak Kodihalli",
                        "email": "deepak.kodihalli.83@gmail.com",
                        "username": "dkodihal"
                    },
                    "message": "I suggest we not do this. Software.Version already documents the path as xyz/openbmc_project/software for both FW and SW. The needs to distinguisg via different URI segments is really a Redfish problem - do we really want to do this? I suggest we just put this under /redfish/v1/UpdateService/FirmwareInventory with a suitable name indicating driver version."
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 13,
                    "reviewer": {
                        "name": "Harshit Aghera",
                        "email": "haghera@nvidia.com",
                        "username": "harshit-aghera"
                    },
                    "message": "Done. We now use documented path /xyz/openbmc_project/software/."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaDriverInformation.cpp",
                    "line": 75,
                    "reviewer": {
                        "name": "Deepak Kodihalli",
                        "email": "deepak.kodihalli.83@gmail.com",
                        "username": "dkodihal"
                    },
                    "message": "Don't we need to do an inventory to software association?"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaDriverInformation.cpp",
                    "line": 75,
                    "reviewer": {
                        "name": "Harshit Aghera",
                        "email": "haghera@nvidia.com",
                        "username": "harshit-aghera"
                    },
                    "message": "Done"
                },
                {
