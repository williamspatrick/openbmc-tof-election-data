            },
            "createdOn": 1768397541,
            "author": {
                "name": "Eldin Lee",
                "email": "eldin.lee@quantatw.com",
                "username": "eldin-lee"
            },
            "kind": "NO_CODE_CHANGE",
            "comments": [
                {
                    "file": "meta-facebook/meta-ventura2/recipes-core/udev/persistent-rs485-port-mapping/ventura2-rs485.rules",
                    "line": 15,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "What does \"Case 1\" and \"Case 2\" refer to?  Can you document that?"
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-core/udev/persistent-rs485-port-mapping/ventura2-rs485.rules",
                    "line": 15,
                    "reviewer": {
                        "name": "Eldin Lee",
                        "email": "eldin.lee@quantatw.com",
                        "username": "eldin-lee"
                    },
                    "message": "The previous udev rules are inherited from Ventura.\nhttps://gerrit.openbmc.org/c/openbmc/openbmc/+/83639\n\nAfter further analysis, the multiple matching cases appear to be a workaround for dynamic USB host controller enumeration.\nOn AST2600, there are two EHCI and one UHCI controllers, so the enumeration order may vary across boots.\n\nMatching on ID_PATH avoids this issue by binding the symlinks to the physical USB topology rather than runtime controller numbering."
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-core/udev/persistent-rs485-port-mapping_0.1.bb",
                    "line": 15,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Aren't udev rules supposed to be prefixed with a number for ordering?"
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-core/udev/persistent-rs485-port-mapping_0.1.bb",
                    "line": 15,
                    "reviewer": {
                        "name": "Eldin Lee",
                        "email": "eldin.lee@quantatw.com",
                        "username": "eldin-lee"
                    },
                    "message": "Acknowledged"
                }
            ],
