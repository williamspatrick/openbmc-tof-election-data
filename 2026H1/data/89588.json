            "kind": "REWORK",
            "comments": [
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Vernon Mauery",
                        "email": "vernon.mauery@gmail.com",
                        "username": "vmauery"
                    },
                    "message": "Security channel keys are insecure. In short, they open up a pathway for privilege escalation by hijacking sessions. We do not want to support this in openbmc. If it is not present, it cannot be exploited."
                },
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Nagavarapu Sai Pavan",
                        "email": "saipavann@ami.com",
                        "username": "saipavann27"
                    },
                    "message": "Thank you for the review. I understand the security concern regarding session hijacking and privilege escalation through Set Channel Security Keys.\n\nSince this command is defined in the IPMI v2.0 specification (Table 22-30), are there any OpenBMC guidelines or precedents for excluding optional but spec-defined commands on security grounds? Understanding this would help me align future contributions accordingly."
                }
            ],
