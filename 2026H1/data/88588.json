                    },
                    "message": "buffer.unpack(receivedCommand) return value is not checked. It will do at common decodeResponseCommonHeader Line 75-78"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuMctpVdm.cpp",
                    "line": 494,
                    "reviewer": {
