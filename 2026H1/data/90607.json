            "comments": [
                {
                    "file": "/COMMIT_MSG",
                    "line": 16,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "What are the \"external transport formats\" you are referring to?  Where are these coming from?  Which application are you expecting to handle them?"
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 16,
                    "reviewer": {
                        "name": "Jayanth Othayoth",
                        "email": "ojayanth@gmail.com",
                        "username": "ojayanth"
                    },
                    "message": "Thanks for the question \u2014 the wording \u201cexternal transport formats\u201d in the commit message is a bit misleading.\nIn this case, the intent is to refer to events originating from external hardware components (e.g., AMC or other device/firmware sources) that are forwarded to the BMC and exposed through the logging framework.\nThe ForwardedEvent is meant to provide a generic normalization layer for such forwarded events so they can be handled consistently within the existing logging infrastructure.\nI will update the commit message to clarify this and avoid confusion."
                }
            ],
