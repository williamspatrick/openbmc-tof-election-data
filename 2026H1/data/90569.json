                    },
                    "message": "Should we put this Redfish mapping in the interface/property description?"
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 14,
                    "reviewer": {
                        "name": "Eric Liu",
                        "email": "liuer@nvidia.com",
