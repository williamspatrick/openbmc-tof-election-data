            "kind": "REWORK",
            "comments": [
                {
                    "file": "oem/meta/libpldmresponder/file_io_type_event_log.cpp",
                    "line": 641,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "These changes probably belong in a separate commit."
                },
                {
                    "file": "oem/meta/libpldmresponder/file_io_type_event_log.cpp",
                    "line": 641,
                    "reviewer": {
                        "name": "Eric Yang",
                        "email": "eric.yang.wiwynn@gmail.com",
                        "username": "fornchu110"
                    },
                    "message": "Done, split out to change [91084].\n\n[91084]: https://gerrit.openbmc.org/c/openbmc/pldm/+/91084"
                },
                {
                    "file": "oem/meta/libpldmresponder/file_io_type_event_log.cpp",
                    "line": 739,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "What can we do to avoid calling phosphor-logging directly?  These end up being 100% custom events that do not show up properly in Redfish and can never create push notifications."
                },
                {
                    "file": "oem/meta/libpldmresponder/file_io_type_event_log.cpp",
                    "line": 739,
                    "reviewer": {
                        "name": "Eric Yang",
                        "email": "eric.yang.wiwynn@gmail.com",
                        "username": "fornchu110"
                    },
                    "message": "Thanks for the feedback.\nI've submitted PDI change [91094] with dedicated event types so these can be recorded via lg2::commit. I placed them under com/meta since the triggers are platform-specific.\nLet me know if you'd prefer a different namespace or structure.\n\n[91094]: https://gerrit.openbmc.org/c/openbmc/phosphor-dbus-interfaces/+/91094"
                }
            ],
