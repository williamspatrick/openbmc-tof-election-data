            "kind": "TRIVIAL_REBASE",
            "comments": [
                {
                    "file": "configurations/nvidia/cx9_mezzanine_module.json",
                    "line": 11,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Also curious on if this is real or not."
                },
                {
                    "file": "configurations/nvidia/cx9_mezzanine_module.json",
                    "line": 11,
                    "reviewer": {
                        "name": "Potin Lai",
                        "email": "potin.lai@quantatw.com",
                        "username": "potinlai"
                    },
                    "message": "For the CX9 modules we have received, the `BOARD_MANUFACTURER` field is set to \"Nvidia\" only.\n\nThis implementation was initially referenced from `cx8_mezzanine_module.json`. Also, according to the documentation provided by Nvidia, there are many other boards (e.g., HMC, HPM) that use \"NVIDIA\" as the manufacturer string.\n\nI guess supporting both \"Nvidia\" and \"NVIDIA\" should able to cover all cases."
                },
                {
                    "file": "configurations/nvidia/cx9_mezzanine_module.json",
                    "line": 11,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Acknowledged.  It seems strange we need to do that; you'd think they'd have their act together for a single board type, but if the maintainers are ok with it, so am I."
                }
            ],
