            "comments": [
                {
                    "file": "src/nvidia-gpu/NvidiaDriverInformation.cpp",
                    "line": 33,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "The `path` and `const std::optional<sdbusplus::object_path>& associationEndpoint` parameters create a readability conflict \u2014 path only feeds parent_path() as a fallback when associationEndpoint is absent, so the NIC caller has to pass an unused path. I drafted a refactor at \nhttps://gerrit.openbmc.org/c/openbmc/dbus-sensors/+/90493 \nto drop path and make associationEndpoint required \u2014 could you take a look?"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaDriverInformation.cpp",
                    "line": 33,
                    "reviewer": {
                        "name": "Eric Liu",
                        "email": "liuer@nvidia.com",
                        "username": "liuer-sys"
                    },
                    "message": "Thanks, I will review this patch."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaDriverInformation.hpp",
                    "line": 31,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "please use `std::optional<std::string>` instead of empty-string sentinel, consistent with the associationEndpoint parameter right above."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaDriverInformation.hpp",
                    "line": 31,
                    "reviewer": {
                        "name": "Eric Liu",
                        "email": "liuer@nvidia.com",
                        "username": "liuer-sys"
                    },
                    "message": "Done, thanks."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaPcieDevice.cpp",
                    "line": 124,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "Consider moving \"Nvidia\" to NvidiaUtils.hpp as a file-scope constant (e.g. `const constexpr char* nvidiaManufacturer = \"Nvidia\";`). \nLets other devices in this module reuse it without duplicating the literal."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaPcieDevice.cpp",
                    "line": 124,
                    "reviewer": {
                        "name": "Eric Liu",
