            "comments": [
                {
                    "file": "meta-facebook/meta-anacapa/recipes-phosphor/gpio/phosphor-gpio-monitor/dimm-power-fault-logger",
                    "line": 23,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "But ... don't we still want to log some kind of event?"
                },
                {
                    "file": "meta-facebook/meta-anacapa/recipes-phosphor/gpio/phosphor-gpio-monitor/dimm-power-fault-logger",
                    "line": 23,
                    "reviewer": {
                        "name": "Rex Fu",
                        "email": "Rex.Fu@amd.com",
                        "username": "tifu_amdeng"
                    },
                    "message": "Yes, I added a fallback log event for this case and marked the failure as an I2C read failure."
                },
                {
                    "file": "meta-facebook/meta-anacapa/recipes-phosphor/gpio/phosphor-gpio-monitor/dimm-power-fault-logger",
                    "line": 45,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Do we really want to put an English sentence in the failure data?  One of the benefits of the standardized log events is to minimize the fragile string parsing."
                },
                {
                    "file": "meta-facebook/meta-anacapa/recipes-phosphor/gpio/phosphor-gpio-monitor/dimm-power-fault-logger",
                    "line": 45,
                    "reviewer": {
                        "name": "Rex Fu",
                        "email": "Rex.Fu@amd.com",
                        "username": "tifu_amdeng"
                    },
                    "message": "Agreed. I changed FAILURE_DATA to use stable tokens instead of free-form text."
                }
            ],
