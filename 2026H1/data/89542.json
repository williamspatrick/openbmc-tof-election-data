            "kind": "REWORK",
            "comments": [
                {
                    "file": "/COMMIT_MSG",
                    "line": 14,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "Tested?  Which system?"
                },
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "Jae, this patch has been submitted half a dozen times.  Please look into the last several times this has been submitted.   If you're seeing this timeout, it means your backend service is broken and not sending progress updates.  Fix your backend please."
                },
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Jae Hyun Yoo",
                        "email": "jae.yoo@oss.qualcomm.com",
                        "username": "jaehyoo"
                    },
                    "message": "Okay, I looked into it and it seems there have been several attempts to change this part. This was actually meant for a customized case that still uses a legacy approach where the service calls a bash script. In that setup, updating progress isn\u2019t very straightforward, which is why I tried to modify it this way. But it looks like the better approach would be to update the script itself so it periodically sets the Progress value using 'busctl set-property' in the script to extend the timeout. Thanks for taking the time to review it and for the helpful suggestion too."
                }
            ],
