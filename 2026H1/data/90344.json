        {
            "number": 2,
            "revision": "f4dcfb5db9b2e3ddf5b1e3589dd127289c77764e",
            "parents": [
                "4091b110c0fecd7148ad45b558dfa7de128f0b93"
            ],
            "ref": "refs/changes/44/90344/2",
            "uploader": {
                "name": "Eric Liu",
                "email": "liuer@nvidia.com",
                "username": "liuer-sys"
            },
            "createdOn": 1779233901,
            "author": {
                "name": "Eric Liu",
                "email": "liuer@nvidia.com",
                "username": "liuer-sys"
            },
            "kind": "NO_CHANGE",
            "comments": [
                {
                    "file": "src/nvidia-gpu/NvidiaGpuEccMode.cpp",
                    "line": 266,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "This uses a boolean lock (internalUpdateInProgress) to distinguish internal vs external sets. An alternative pattern (used in https://gerrit.openbmc.org/c/openbmc/dbus-sensors/+/90189 PS2 for PowerCap) is register_property with explicit setter+getter callbacks, where the BMC updates its own member and the getter returns it \u2014 no flag needed.\nBoth work, but consistency across the codebase may be worth considering."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuEccMode.cpp",
                    "line": 266,
                    "reviewer": {
                        "name": "Eric Liu",
                        "email": "liuer@nvidia.com",
                        "username": "liuer-sys"
                    },
                    "message": "Done, thanks."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuEccMode.cpp",
                    "line": 310,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "On Set failure, the optimistic pending property stays stale until the next Get polling cycle (~30s). That's long enough for a user to observe the \"updated\" pending, trigger a GPU reset, then find ECC mode didn't change as expected. \nConsider triggering update() on Set failure to refresh pending from hardware sooner."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuEccMode.cpp",
                    "line": 310,
                    "reviewer": {
                        "name": "Eric Liu",
                        "email": "liuer@nvidia.com",
                        "username": "liuer-sys"
                    },
                    "message": "Done, thanks."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuEccMode.cpp",
                    "line": 391,
                    "reviewer": {
                        "name": "Ender",
                        "email": "andhsieh@nvidia.com",
                        "username": "Ender-Hsieh"
                    },
                    "message": "Same as Line 310"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaGpuEccMode.cpp",
                    "line": 391,
                    "reviewer": {
                        "name": "Eric Liu",
                        "email": "liuer@nvidia.com",
                        "username": "liuer-sys"
                    },
                    "message": "Done, thanks."
                }
            ],
