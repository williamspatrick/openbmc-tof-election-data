                {
                    "file": "phosphor-ldap-config/ldap_mapper_serialize.hpp",
                    "line": 15,
                    "reviewer": {
                        "name": "Ravi Teja",
                        "email": "raviteja28031990@gmail.com",
                        "username": "raviteja-b"
                    },
                    "message": "why this was removed? fs::path was used in this file right"
                },
                {
                    "file": "phosphor-ldap-config/ldap_mapper_serialize.hpp",
                    "line": 15,
                    "reviewer": {
                        "name": "Vijaysankar Ravi",
                        "email": "vijaysankarr@ami.com",
                        "username": "Vijaysankarr"
                    },
                    "message": "namespace fs was removed from the header to avoid leaking the alias into all consumers of this header.\nThe .cpp file still uses fs:: and it's covered by the namespace fs = std::filesystem; declaration added at the top of ldap_mapper_serialize.cpp."
                },
                {
                    "file": "phosphor-ldap-config/ldap_mapper_serialize.hpp",
                    "line": 15,
                    "reviewer": {
                        "name": "Ravi Teja",
                        "email": "raviteja28031990@gmail.com",
                        "username": "raviteja-b"
                    },
                    "message": "did not really understand this point \"avoid leaking the alias\" and  dont see this header file consumed in multiple place"
                },
                {
                    "file": "phosphor-ldap-config/ldap_mapper_serialize.hpp",
                    "line": 15,
                    "reviewer": {
                        "name": "Vijaysankar Ravi",
                        "email": "vijaysankarr@ami.com",
                        "username": "Vijaysankarr"
                    },
                    "message": "ldap_mapper_serialize.hpp is included in ldap_mapper_entry.cpp, ldap_config.cpp, and ldap_mapper_serialize.cpp.\nThe latter two have their own namespace fs =; ldap_mapper_entry.cpp does not, it was silently picking up the alias from the header without needing it.\nUsing std::filesystem::path explicitly in the header ensures it does not impose aliases on its consumers."
                }
            ],
