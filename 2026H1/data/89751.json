                    "reviewer": {
                        "name": "AKash-A007",
                        "email": "mirrorghost007@gmail.com",
                        "username": "AKash-A007"
                    },
                    "message": "Done. Broke the mapping logic out into helper functions:\n`getFunctionTypeFromDbus()` and `getDeviceClassFromDbus()`\nThese functions directly match the full D-Bus strings and return\nthe appropriate Redfish enum values."
                },
