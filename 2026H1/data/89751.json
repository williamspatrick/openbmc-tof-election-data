                {
                    "file": "redfish-core/lib/pcie.hpp",
                    "line": 748,
                    "reviewer": {
                        "name": "AKash-A007",
                        "email": "mirrorghost007@gmail.com",
                        "username": "AKash-A007"
                    },
                    "message": "Done. Removed the string stripping logic and now directly match the\nfull D-Bus enum strings as you suggested. This is simplerand faster\nand generates less code."
                },
                {
                    "file": "redfish-core/lib/pcie.hpp",
                    "line": 763,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "Please look at other examples of how to break these out into a method."
                },
