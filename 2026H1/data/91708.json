            "kind": "REWORK",
            "comments": [
                {
                    "file": "yaml/xyz/openbmc_project/Logging/Settings.interface.yaml",
                    "line": 11,
                    "reviewer": {
                        "name": "Matt Spinler",
                        "email": "spinler@us.ibm.com",
                        "username": "spinler"
                    },
                    "message": "I think 'Policy' is too generic, as a policy could be about anything."
                },
                {
                    "file": "yaml/xyz/openbmc_project/Logging/Settings.interface.yaml",
                    "line": 11,
                    "reviewer": {
                        "name": "mahalakshmik-1",
                        "email": "mahalakshmik@ami.com",
                        "username": "mahalakshmik-1"
                    },
                    "message": "Agreed, Policy was too generic.\nI renamed the property to LogRetentionPolicy so the intent is explicit: it controls log retention behavior when capacity is reached (Linear vs Circular).\nThis also aligns the naming with the Redfish mapping now documented in the interface description."
                }
            ],
