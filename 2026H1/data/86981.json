            "kind": "REWORK",
            "comments": [
                {
                    "file": "meta-facebook/meta-ventura2/recipes-phosphor/settings/phosphor-settings-defaults-native/ventura2-temporary-software-versions.yaml",
                    "line": 1,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Why is this added and not part of phosphor-bmc-code-mgmt?"
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-phosphor/settings/phosphor-settings-defaults-native/ventura2-temporary-software-versions.yaml",
                    "line": 1,
                    "reviewer": {
                        "name": "KyleHsieh.Quanta",
                        "email": "Kyle.Hsieh@quantatw.com",
                        "username": "KyleHsieh171"
                    },
                    "message": "The RMC CPLD is handled via phosphor-bmc-code-mgmt (currently under review in https://gerrit.openbmc.org/c/openbmc/phosphor-bmc-code-mgmt/+/88229)"
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-phosphor/settings/phosphor-settings-defaults-native/ventura2-temporary-software-versions.yaml",
                    "line": 17,
                    "reviewer": {
                        "name": "Xinyuan Wang",
                        "email": "wang.x.6f@gmail.com",
                        "username": "wangx6f"
                    },
                    "message": "This is a NIC right? Can we just name it `nic`?"
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-phosphor/settings/phosphor-settings-defaults-native/ventura2-temporary-software-versions.yaml",
                    "line": 17,
                    "reviewer": {
                        "name": "KyleHsieh.Quanta",
                        "email": "Kyle.Hsieh@quantatw.com",
                        "username": "KyleHsieh171"
                    },
                    "message": "Thanks for your reply. The reason I used 'E810' instead of just 'nic' is to provide clear visibility of the device version."
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-phosphor/settings/phosphor-settings-defaults-native/ventura2-temporary-software-versions.yaml",
                    "line": 17,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Please use `NIC_E810`."
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-phosphor/settings/phosphor-settings-defaults-native/ventura2-temporary-software-versions.yaml",
                    "line": 17,
                    "reviewer": {
                        "name": "KyleHsieh.Quanta",
                        "email": "Kyle.Hsieh@quantatw.com",
                        "username": "KyleHsieh171"
                    },
                    "message": "Adjust to use PLDM"
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-phosphor/settings/phosphor-settings-defaults-native/ventura2-temporary-software-versions.yaml",
                    "line": 18,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "What is the plan for getting support for the E810 in PLDM or phosphor-bmc-code-mgmt?"
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-phosphor/settings/phosphor-settings-defaults-native/ventura2-temporary-software-versions.yaml",
                    "line": 18,
                    "reviewer": {
                        "name": "KyleHsieh.Quanta",
                        "email": "Kyle.Hsieh@quantatw.com",
                        "username": "KyleHsieh171"
                    },
                    "message": "We use the PLDM stack to fetch its version for E810 NIC and related change for PLDM firmware version change https://gerrit.openbmc.org/c/openbmc/pldm/+/89351"
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-phosphor/settings/phosphor-settings-defaults-native/ventura2-temporary-software-versions.yaml",
                    "line": 25,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Why is this not using a phosphor-bmc-code-mgmt config?"
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-phosphor/settings/phosphor-settings-defaults-native/ventura2-temporary-software-versions.yaml",
                    "line": 25,
                    "reviewer": {
                        "name": "KyleHsieh.Quanta",
                        "email": "Kyle.Hsieh@quantatw.com",
                        "username": "KyleHsieh171"
                    },
                    "message": "We use phosphor-bmc-code-mgmt and entity-manager for them because their implementation from\nhttps://gerrit.openbmc.org/c/openbmc/entity-manager/+/88804"
                }
            ],
