            "comments": [
                {
                    "file": "meta-aspeed/dynamic-layers/zephyrcore-layer/recipes-kernel/zephyr-aspeed/zephyr-aspeed-src.inc",
                    "line": 11,
                    "reviewer": {
                        "name": "Mayank Metha D",
                        "email": "mayank.metha@intel.com",
                        "username": "mmetha"
                    },
                    "message": "Can this be updated to upstream zephyrproject-rtos?"
                },
                {
                    "file": "meta-aspeed/dynamic-layers/zephyrcore-layer/recipes-kernel/zephyr-aspeed/zephyr-aspeed-src.inc",
                    "line": 11,
                    "reviewer": {
                        "name": "Vince Chang",
                        "email": "vince_chang@aspeedtech.com",
                        "username": "VinceChang6637"
                    },
                    "message": "The Aspeed fork is currently used because it contains\nplatform-specific patches required for the Aspeed Zephyr\nplatform support. These patches are not yet available in\nthe upstream zephyrproject-rtos repository."
                },
                {
                    "file": "meta-aspeed/dynamic-layers/zephyrcore-layer/recipes-kernel/zephyr-aspeed/zephyr-aspeed-src.inc",
                    "line": 11,
                    "reviewer": {
                        "name": "Troy Lee",
                        "email": "troy_lee@aspeedtech.com",
                        "username": "LeeTroy"
                    },
                    "message": "Upstreaming BootMCU (RISC-V) support into Zephyr official is planned, and we're currently occupied by CA35 Linux kernel upstreaming. The work will start a bit later."
                },
                {
                    "file": "meta-aspeed/dynamic-layers/zephyrcore-layer/recipes-kernel/zephyr-aspeed/zephyr-aspeed-src.inc",
                    "line": 11,
                    "reviewer": {
                        "name": "Mayank Metha D",
                        "email": "mayank.metha@intel.com",
                        "username": "mmetha"
                    },
                    "message": "Can we get an timeline regarding the Zephyr upstreaming?"
                },
                {
                    "file": "meta-aspeed/dynamic-layers/zephyrcore-layer/recipes-kernel/zephyr-aspeed/zephyr-aspeed-src.inc",
                    "line": 11,
                    "reviewer": {
                        "name": "Vince Chang",
                        "email": "vince_chang@aspeedtech.com",
                        "username": "VinceChang6637"
                    },
                    "message": "We are planning to start the Zephyr upstreaming in September."
                }
