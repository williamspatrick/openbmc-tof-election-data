            "kind": "REWORK",
            "comments": [
                {
                    "file": "/COMMIT_MSG",
                    "line": 16,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "Please read the documentation on patch testing (which I know you've been pointed to before)."
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 43,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "The testing here isn't nearly enough.  You've changed some core functions that apply to both multihost and non multihost.  We need some level of testing to gain confidence that they're correct.\n\nTesting a couple URIs manually doesn't test the whole ComputerSystemCollection tree, which is effected by this change."
                },
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "Overall in support of this, but this isn't just a minor change, so testing is important."
                }
            ],
