            "comments": [
                {
                    "file": "/COMMIT_MSG",
                    "line": 19,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "This isn't obvious to me why this is a good design decision.  It's better to lose an event than to potentially have duplicate ones?  That's counter-intuitive."
