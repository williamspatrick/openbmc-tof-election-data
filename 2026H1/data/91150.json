                {
                    "file": "meson.build",
                    "line": 202,
                    "reviewer": {
                        "name": "Matt Johnston",
                        "email": "matt@codeconstruct.com.au",
                        "username": "mkj"
                    },
                    "message": "The sizeof is still needed on platforms without malloc. Those use MCTP_SIZEOF_BINDING_I2C to size a static storage buffer."
                },
                {
                    "file": "meson.build",
                    "line": 202,
                    "reviewer": {
                        "name": "Bryan Huang",
                        "email": "bmwhale.c@gmail.com",
                        "username": "bmWhale"
                    },
                    "message": "Hi Matt,\n\nThanks for pointing this out! I completely overlooked the static allocation use cases for platforms without malloc.\n\nI will keep MCTP_SIZEOF_BINDING_I2C intact (and revert any removal of it in meson.build) to ensure static storage sizing still works. I have updated the commit message and the patch to only update the test/fuzz code to use the new APIs."
                }
            ],
