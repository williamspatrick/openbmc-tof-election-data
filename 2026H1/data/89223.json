            "kind": "TRIVIAL_REBASE",
            "comments": [
                {
                    "file": "/COMMIT_MSG",
                    "line": 12,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "If you want this commit to be considered, you need to document the \"why\".  We can read the code and see what you did.  I've read the whole commit message and it isn't communicated why you want this change."
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 12,
                    "reviewer": {
                        "name": "mikehqt",
                        "email": "mike_hsieh@quantatw.com",
                        "username": "mikehqt"
                    },
                    "message": "Acknowledged"
                },
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Andrew Geissler",
                        "email": "geissonator@yahoo.com",
                        "username": "geissonator"
                    },
                    "message": "There was some discussion on this log over in the https://gerrit.openbmc.org/c/openbmc/phosphor-state-manager/+/86701 series and the general agreement was that it's useful but if users don't want it, they can add it to the ignore log for their systems."
                }
