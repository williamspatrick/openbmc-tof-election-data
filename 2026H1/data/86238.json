                    "line": 538,
                    "reviewer": {
                        "name": "Deepak Kodihalli",
                        "email": "deepak.kodihalli.83@gmail.com",
                        "username": "dkodihal"
                    },
                    "message": "The callback is different, and I also don't think it's a lot of code dup happening here."
                },
                {
                    "file": "src/nvidia-gpu/NvidiaDeviceDiscovery.cpp",
                    "line": 833,
                    "reviewer": {
                        "name": "Harshit Aghera",
                        "email": "haghera@nvidia.com",
                        "username": "harshit-aghera"
                    },
                    "message": "Can we call this function from function `queryEndpoints` instead of duplicating dbus method call at both the places?"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaDeviceDiscovery.cpp",
                    "line": 833,
                    "reviewer": {
                        "name": "Deepak Kodihalli",
                        "email": "deepak.kodihalli.83@gmail.com",
                        "username": "dkodihal"
                    },
                    "message": "Will check."
