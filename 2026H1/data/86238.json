                        "username": "harshit-aghera"
                    },
                    "message": "This dbus method call and one in the function `checkAssociationAndQueryDevice` look very similar, is there opportunity for de-duplication?"
                },
                {
                    "file": "src/nvidia-gpu/NvidiaDeviceDiscovery.cpp",
                    "line": 538,
                    "reviewer": {
                        "name": "Deepak Kodihalli",
                        "email": "deepak.kodihalli.83@gmail.com",
                        "username": "dkodihal"
                    },
                    "message": "Will check."
                },
                {
