                    },
                    "message": "Ack. Thanks for the review."
                },
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Jason Westover",
                        "email": "jwestover@nvidia.com",
                        "username": "j-westover"
                    },
                    "message": "The core store change looks great and is directionally correct and should fix the common stable-order case. \n\nPlease update Network.vue\u2019s local tabIndex to be synchronized with the preserved Vuex selection, otherwise the UI and save target can still diverge when the interface order changes or the selected NIC disappears."
                },
                {
                    "file": "src/store/modules/Settings/NetworkStore.js",
                    "line": 98,
                    "reviewer": {
                        "name": "Jason Westover",
                        "email": "jwestover@nvidia.com",
                        "username": "j-westover"
                    },
                    "message": "this throws.\nconsider: `const firstInterfaceId = ethernetData?.[0]?.Id || '';`"
                },
                {
                    "file": "src/store/modules/Settings/NetworkStore.js",
                    "line": 99,
                    "reviewer": {
                        "name": "Jason Westover",
                        "email": "jwestover@nvidia.com",
                        "username": "j-westover"
                    },
                    "message": "the rendered selected tab is controlled by `Network.vue\u2019`s local `tabIndex`, not Vuex `selectedInterfaceIndex`.\n\nRecommendation:  make `tabIndex` a computed getter/setter backed by Vuex `selectedInterfaceIndex` instead of local component state in `Network.vue`\n\nAlso update the initial page load of `Network.vue` to no longer forcibly reset selection to index 0."
                },
                {
                    "file": "src/store/modules/Settings/NetworkStore.js",
                    "line": 99,
                    "reviewer": {
                        "name": "Jason Westover",
                        "email": "jwestover@nvidia.com",
                        "username": "j-westover"
                    },
                    "message": "This line is too long"
                }
