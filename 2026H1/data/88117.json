            "createdOn": 1773901502,
            "author": {
                "name": "Potin Lai",
                "email": "potin.lai@quantatw.com",
                "username": "potinlai"
            },
            "kind": "REWORK",
            "comments": [
                {
                    "file": "meta-facebook/recipes-fb/hmc-datetime-sync/files/hmc-datetime-sync.service",
                    "line": 5,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Why is this simple and not oneshot?"
                },
                {
                    "file": "meta-facebook/recipes-fb/hmc-datetime-sync/files/hmc-datetime-sync.service",
                    "line": 5,
                    "reviewer": {
                        "name": "Potin Lai",
                        "email": "potin.lai@quantatw.com",
                        "username": "potinlai"
                    },
                    "message": "This service includes retry mechanism, which might take up to 150 seconds in worst case, so I think this should set type as `simple` to prevent other services get stuck."
                },
                {
                    "file": "meta-facebook/recipes-fb/hmc-datetime-sync/files/hmc-datetime-sync.service",
                    "line": 5,
                    "reviewer": {
                        "name": "Potin Lai",
                        "email": "potin.lai@quantatw.com",
                        "username": "potinlai"
                    },
                    "message": "Acknowledged"
                },
                {
                    "file": "meta-facebook/recipes-fb/hmc-datetime-sync/files/hmc-datetime-sync.timer",
                    "line": 5,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "This implementation has a bug where if the date is set on the BMC (by NTP or something else) that change won't be propagated to the HMC for up to an hour.  The fix that NV uses downstream is to set up a match expression on datetimed, which releases a property change on every date set, but that requires this to be a real service."
                },
                {
                    "file": "meta-facebook/recipes-fb/hmc-datetime-sync/files/hmc-datetime-sync.timer",
                    "line": 5,
                    "reviewer": {
                        "name": "Potin Lai",
                        "email": "potin.lai@quantatw.com",
                        "username": "potinlai"
                    },
                    "message": "Hi @ed@tanous.net,\nAppreciate your advice. Could you share more information or repo about the datetimed service you mentioned?"
                },
                {
                    "file": "meta-facebook/recipes-fb/hmc-datetime-sync/files/hmc-datetime-sync.timer",
                    "line": 5,
                    "reviewer": {
                        "name": "Potin Lai",
                        "email": "potin.lai@quantatw.com",
                        "username": "potinlai"
                    },
                    "message": "Acknowledged, it will be considered it for future enhancement"
                }
            ],
