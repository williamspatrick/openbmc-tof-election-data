            "kind": "TRIVIAL_REBASE",
            "comments": [
                {
                    "file": "meta-facebook/recipes-fb/hmc-datetime-sync/files/hmc-datetime-sync.service",
                    "line": 3,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Why?\n\n1. There is nothing here that interacts with entity-manager.\n2. If there was, just having EM running doesn't give you any certainty that objects needed from it have been created yet."
                },
                {
                    "file": "meta-facebook/recipes-fb/hmc-datetime-sync/files/hmc-datetime-sync.service",
                    "line": 3,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Don't we need some kind of wait for \"hmc-ready\"?"
                },
                {
                    "file": "meta-facebook/recipes-fb/hmc-datetime-sync/files/hmc-datetime-sync.service",
                    "line": 3,
                    "reviewer": {
                        "name": "Potin Lai",
                        "email": "potin.lai@quantatw.com",
                        "username": "potinlai"
                    },
                    "message": "Remove EntityManager dependence."
                },
                {
                    "file": "meta-facebook/recipes-fb/hmc-datetime-sync/files/hmc-datetime-sync.service",
                    "line": 3,
                    "reviewer": {
                        "name": "Potin Lai",
                        "email": "potin.lai@quantatw.com",
                        "username": "potinlai"
                    },
                    "message": "In [88334](https://gerrit.openbmc.org/c/openbmc/openbmc/+/88334), I added a restart of the `hmc-datetime-sync` service when HMC_READY-I is asserted. Does this change look okay to you?"
                },
                {
                    "file": "meta-facebook/recipes-fb/hmc-datetime-sync/files/hmc-datetime-sync.service",
                    "line": 3,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Acknowledged"
                }
            ],
