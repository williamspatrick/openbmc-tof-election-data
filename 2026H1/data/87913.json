                    },
                    "message": "This line was removed"
                },
                {
                    "file": "src/msgbuf/core.h",
                    "line": 1710,
                    "reviewer": {
                        "name": "Vishnunithyasoundhar S",
                        "email": "vishnunithyasoundhar.s@intel.com",
                        "username": "VishnuNithyaSoundharS"
                    },
                    "message": "I think length should overflow only when its length > INTMAX_MAX unless you need one empty space available at the end. Can you pls recheck this?\n\nSimilar implementation\n\nhttps://github.com/openbmc/libpldm/blob/494f34fae1a2eb7c9b86d431e75e55160c74d83b/src/msgbuf/core.h#L143"
                },
                {
