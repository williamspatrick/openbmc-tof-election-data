            "comments": [
                {
                    "file": "yaml/xyz/openbmc_project/Sensor/Value.interface.yaml",
                    "line": 7,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "\"charge\" acceptable?"
                },
                {
                    "file": "yaml/xyz/openbmc_project/Sensor/Value.interface.yaml",
                    "line": 7,
                    "reviewer": {
                        "name": "James Athappilly",
                        "email": "jamesatha@meta.com",
                        "username": "jamesatha"
                    },
                    "message": "Coulomb is the normal SI unit for charge - it seemed more intuitive to add capacity as that's normally how we talk about batteries."
                },
                {
                    "file": "yaml/xyz/openbmc_project/Sensor/Value.interface.yaml",
                    "line": 7,
                    "reviewer": {
                        "name": "James Athappilly",
                        "email": "jamesatha@meta.com",
                        "username": "jamesatha"
                    },
                    "message": "Changed to charge"
                },
                {
                    "file": "yaml/xyz/openbmc_project/Sensor/Value.interface.yaml",
                    "line": 87,
                    "reviewer": {
                        "name": "Patrick Williams",
                        "email": "patrick@stwcx.xyz",
                        "username": "williamspatrick"
                    },
                    "message": "Why not Ah?"
                },
                {
                    "file": "yaml/xyz/openbmc_project/Sensor/Value.interface.yaml",
                    "line": 87,
                    "reviewer": {
                        "name": "James Athappilly",
                        "email": "jamesatha@meta.com",
                        "username": "jamesatha"
                    },
                    "message": "The reasoning here is that most devices monitored by the BMC aren't connected to huge batteries so this prevents us from doing a lot of unnecessary division and decimal points. \n\nWe can change to Ah if that's better for the community"
                },
                {
                    "file": "yaml/xyz/openbmc_project/Sensor/Value.interface.yaml",
                    "line": 87,
                    "reviewer": {
                        "name": "James Athappilly",
                        "email": "jamesatha@meta.com",
                        "username": "jamesatha"
                    },
                    "message": "changed to charge"
                }
            ],
