                    "reviewer": {
                        "name": "Souvik Roy",
                        "email": "souvikroyofficial10@gmail.com",
                        "username": "souvik1914581"
                    },
                    "message": "This block decrements the counter and notifies. Can this be moved to line 271, after the \"actions on the chassis result are complete\"? This way `l_decChassisCnt` variable won't be needed."
                },
                {
                    "file": "vpd-manager/src/thread_manager.cpp",
                    "line": 282,
                    "reviewer": {
                        "name": "Anupama B R",
                        "email": "anupama.b.r1@ibm.com",
