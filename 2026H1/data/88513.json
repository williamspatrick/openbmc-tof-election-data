            "kind": "REWORK",
            "comments": [
                {
                    "file": "meta-facebook/meta-ventura2/recipes-phosphor/sensors/dbus-sensors/cable-config.json",
                    "line": 3,
                    "reviewer": {
                        "name": "Jagpal S Gill",
                        "email": "paligill@gmail.com",
                        "username": "jagpalgill"
                    },
                    "message": "Better to use RackDripTrayLeakPort1 to keep it in sync with ventura nomenclature https://grok.openbmc.org/xref/openbmc/openbmc/meta-facebook/meta-ventura/recipes-phosphor/sensors/dbus-sensors/cable-config.json?r=ae17ccdab2408fc89aa10754eb5ac8f0fd2f0369#4"
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-phosphor/sensors/dbus-sensors/cable-config.json",
                    "line": 3,
                    "reviewer": {
                        "name": "Jagpal S Gill",
                        "email": "paligill@gmail.com",
                        "username": "jagpalgill"
                    },
                    "message": "Is this new port on ventura 2 as i don't see them in ventura cable connfig json."
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-phosphor/sensors/dbus-sensors/cable-config.json",
                    "line": 3,
                    "reviewer": {
                        "name": "Eldin Lee",
                        "email": "eldin.lee@quantatw.com",
                        "username": "eldin-lee"
                    },
                    "message": "We aligned with the same naming convention after internal discussion (see [89917](https://gerrit.openbmc.org/c/openbmc/entity-manager/+/89917))"
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-phosphor/sensors/dbus-sensors/cable-config.json",
                    "line": 3,
                    "reviewer": {
                        "name": "Eldin Lee",
                        "email": "eldin.lee@quantatw.com",
                        "username": "eldin-lee"
                    },
                    "message": "v1 and v2 are not directly compatible.\nPlease see the differences below:\n\nV1:\n\nRackDripPanPort\nRackFloorLeakPort1\nRackFloorLeakPort2\nRackColdManifoldPort\nRackHotManifoldPort\n\nV2:\n\nRackDripPanPort1\nRackDripPanPort2\nRackLeakSparePort1\nRackLeakSparePort2\nRackLeakSparePort3\nRackFloorLeakPort1\nRackFloorLeakPort2\nRackFloorLeakPort3\nRackVerticalColdManifoldLeakPort\nRackVerticalHotManifoldLeakPort\nRackHorizontalColdManifoldLeakPort\nRackHorizontalHotManifoldLeakPort"
                },
                {
                    "file": "meta-facebook/meta-ventura2/recipes-phosphor/sensors/dbus-sensors/cable-config.json",
                    "line": 4,
                    "reviewer": {
                        "name": "Jagpal S Gill",
                        "email": "paligill@gmail.com",
                        "username": "jagpalgill"
                    },
                    "message": "Is this new port on ventura 2 as i don't see them in ventura cable connfig json."
                },
