            "kind": "TRIVIAL_REBASE",
            "comments": [
                {
                    "file": "/COMMIT_MSG",
                    "line": 17,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "Do you have example code for this complication?  This is already true given that EM config files are templated, so you already could have two templates that produce the same name."
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 17,
                    "reviewer": {
                        "name": "Alexander",
                        "email": "alexander.hansen@9elements.com",
                        "username": "pointbazaar"
                    },
                    "message": "There is no longer a `1:1` mapping between a config record and an  object path.\n\nI have not seen any reasoning as to why we would need it to be a `m:n` mapping.\n\nThat's the complication i am talking about here."
                }
            ],
