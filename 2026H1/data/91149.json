            "comments": [
                {
                    "file": "i2c.c",
                    "line": 303,
                    "reviewer": {
                        "name": "Andrew Jeffery",
                        "email": "andrew@codeconstruct.com.au",
                        "username": "amboar"
                    },
                    "message": "Nit: `free()` is specified as taking no action if the pointer argument is a null pointer, so there's no need to guard this call."
                },
                {
                    "file": "i2c.c",
                    "line": 303,
                    "reviewer": {
                        "name": "Bryan Huang",
                        "email": "bmwhale.c@gmail.com",
                        "username": "bmWhale"
                    },
                    "message": "Thanks \u2014 good catch. free(NULL) is defined to be a no-op in ISO C, so the check is unnecessary. I've removed the guard and updated the patchset."
                }
            ],
