            "kind": "TRIVIAL_REBASE",
            "comments": [
                {
                    "file": "/COMMIT_MSG",
                    "line": 22,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "This isn't really sufficient.  This array update stuff is a mess of corner cases, and you need to handle all of them.  Please take a look at the Redfish spec for all the possibilities."
                },
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "garybeihl",
                        "email": "garybeihl@microsoft.com",
                        "username": "garybeihl"
                    },
                    "message": "Gentle ping \u2014 this small bmcweb ethernet fix has been sitting on PS4 for about 5 weeks with Verified+1 and no review activity. Small change (+9/-12) that closes openbmc/bmcweb#308. Would appreciate a look when you get a chance. Thank you!"
                },
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "At least based on reading this, this looks like a bug."
                },
                {
                    "file": "/PATCHSET_LEVEL",
                    "line": 0,
                    "reviewer": {
                        "name": "garybeihl",
                        "email": "garybeihl@microsoft.com",
                        "username": "garybeihl"
                    },
                    "message": "Thanks for the review, Ed. Rather than iterate on a D-Bus round-trip optimization that doesn't address the real root cause of issue #308, I'm abandoning this change."
                },
                {
                    "file": "redfish-core/lib/ethernet.hpp",
                    "line": 1702,
                    "reviewer": {
                        "name": "Ed Tanous",
                        "email": "ed@tanous.net",
                        "username": "edtanous"
                    },
                    "message": "As written you will now introduce a bug if you change the gateway, or multiple IP addresses have the same gateway, some of hte ip addresses will fail to create."
                }
            ],
