                {
                    "file": "src/storagecommands.cpp",
                    "line": 631,
                    "reviewer": {
                        "name": "Nnamdi Ajah",
                        "email": "nnamdi@cloudflare.com",
                        "username": "annamdi"
                    },
                    "message": "Thanks for pointing that out. I have removed PRODUCT_SERIAL_NUMBER and BOARD_SERIAL_NUMBER from the searchable field properties."
                }
