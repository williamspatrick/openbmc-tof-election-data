            "kind": "REWORK",
            "comments": [
                {
                    "file": "phosphor-ldap-config/ldap_config.cpp",
                    "line": 823,
                    "reviewer": {
                        "name": "Vijaysankar Ravi",
                        "email": "vijaysankarr@ami.com",
                        "username": "Vijaysankarr"
                    },
                    "message": "is.good() returns false on eofbit, which is the normal terminal state after cereal reads the last serialized field to EOF.\nThis will cause valid, non-corrupt persistence files to fail deserialization on every boot.\n\nCereal already throws cereal::Exception on actual read failures, and the existing catch block handles that.\n\nPlease consider removing this block."
                },
                {
                    "file": "phosphor-ldap-config/ldap_config.cpp",
                    "line": 823,
                    "reviewer": {
                        "name": "Ravi Teja",
                        "email": "raviteja28031990@gmail.com",
                        "username": "raviteja-b"
                    },
                    "message": "ya agreed, done"
                }
            ],
