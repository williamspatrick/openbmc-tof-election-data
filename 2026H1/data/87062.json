            "comments": [
                {
                    "file": "/COMMIT_MSG",
                    "line": 7,
                    "reviewer": {
                        "name": "Matt Spinler",
                        "email": "spinler@us.ibm.com",
                        "username": "spinler"
                    },
                    "message": "I'm not sure what multi-host has to do with this commit other than a multi-host server will use it in the future?"
                },
                {
                    "file": "/COMMIT_MSG",
                    "line": 7,
                    "reviewer": {
                        "name": "Alexander",
                        "email": "alexander.hansen@9elements.com",
                        "username": "pointbazaar"
                    },
                    "message": "yep, it is not constrained to multi-host systems, but represents a rework of sorts. Renamed it to \"fan inventory rework\"."
                },
                {
                    "file": "configurations/tyan/s5549_baseboard.json",
                    "line": 477,
                    "reviewer": {
                        "name": "Matt Spinler",
                        "email": "spinler@us.ibm.com",
                        "username": "spinler"
                    },
                    "message": "I may just not be following something, but in this commit don't you also need the PortType: \"cooling\" side?"
                },
                {
                    "file": "configurations/tyan/s5549_baseboard.json",
                    "line": 477,
                    "reviewer": {
                        "name": "Alexander",
                        "email": "alexander.hansen@9elements.com",
                        "username": "pointbazaar"
                    },
                    "message": "Yes. I have been waiting for MBX 1.57 chassis to get merged but now i can break out the fans from that chassis config and implement `cooling` port on each fan.\n\nThe new revision has the fans broken out with the right `cooling` Port.\n\nAlso limited the change to S8030 baseboard + MBX 1.57 chassis for now."
                }
            ],
