                    "line": 102,
                    "reviewer": {
                        "name": "Deepak Kodihalli",
                        "email": "deepak.kodihalli.83@gmail.com",
                        "username": "dkodihal"
                    },
                    "message": "This is a bit error prone to remember to do this in all the exit paths. Don't we have such a check in bmcwen already?"
                },
                {
                    "file": "fw-update/update_manager.cpp",
                    "line": 102,
                    "reviewer": {
                        "name": "Unive Tien",
                        "email": "unive.tien.wiwynn@gmail.com",
                        "username": "UniveTien"
                    },
                    "message": "Thanks for reviewing,\n> This is a bit error prone to remember to do this in all the exit paths.\n\nMade a guard to handle the error paths rather than manually doing this.\n> Don't we have such a check in bmcwen already?\n\nUpdate procedure might be triggered from out of bmcweb."
                }
