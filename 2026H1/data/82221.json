            "comments": [
                {
                    "file": "redfish-core/lib/update_service.hpp",
                    "line": 1227,
                    "reviewer": {
                        "name": "Gunnar Mills",
                        "email": "gunnar@gmills.xyz",
                        "username": "gtmills"
                    },
                    "message": "Why does this need to be under the Multi Computer system flag?"
                },
                {
                    "file": "redfish-core/lib/update_service.hpp",
                    "line": 1227,
                    "reviewer": {
                        "name": "Alexander",
                        "email": "alexander.hansen@9elements.com",
                        "username": "pointbazaar"
                    },
                    "message": "The next patch adds `RelatedItem` in multi-host case.\n\nThat's why i wanted to have some consistency also in the single-host case.\n\nSome may view this as redundant to add `RelatedItem` but i would prefer the redfish client be able to rely on it somewhat, to always find a system which is associated to the software inventory item.\n\nWe have to check the option here because if the multi-host option is enabled it is not allowed anymore to do hardcoding such as `BMCWEB_REDFISH_SYSTEM_URI_NAME`.\n\n\nLet me know if i should abandon the patch."
                },
                {
                    "file": "redfish-core/lib/update_service.hpp",
                    "line": 1227,
                    "reviewer": {
                        "name": "Alexander",
                        "email": "alexander.hansen@9elements.com",
                        "username": "pointbazaar"
                    },
                    "message": "Closing this discussion thread since there was no further response in 10 days."
                }
